#Область ПрограммныйИнтерфейс

// Вызывается только на сервере из модуля формы, не удалённым вызовом клиента.
Процедура ПостроитьПоляВида(Форма) Экспорт
	Для Каждого СтрокаКарты Из Форма.ПоляФормы Цикл
		Форма.Элементы.Удалить(Форма.Элементы[СтрокаКарты.Имя]);
	КонецЦикла;
	Удаляемые = Новый Массив;
	Для Каждого СтрокаКарты Из Форма.ПоляФормы Цикл
		Удаляемые.Добавить(СтрокаКарты.Имя);
	КонецЦикла;
	Форма.ПоляФормы.Очистить();
	Если Удаляемые.Количество() > 0 Тогда
		Форма.ИзменитьРеквизиты(Новый Массив, Удаляемые);
	КонецЕсли;

	Поля = КонструкторВидов.ПоляВида(Форма.Объект.ВидДокумента);
	Добавляемые = Новый Массив;
	Для Каждого Поле Из Поля Цикл
		// Имя элемента не зависит от пользовательского идентификатора: исключены
		// коллизии со стандартными реквизитами и недопустимые символы в именах.
		Имя = "ПолеВида" + Формат(Добавляемые.Количество() + 1, "ЧГ=0");
		Типы = Новый Массив;
		Типы.Добавить(Поле.ТипЗначения);
		Добавляемые.Добавить(Новый РеквизитФормы(Имя, Новый ОписаниеТипов(Типы, Новый КвалификаторыЧисла(15, 2),
			Новый КвалификаторыСтроки(500))));
		Карта = Форма.ПоляФормы.Добавить();
		Карта.Имя = Имя;
		Карта.Идентификатор = Поле.Идентификатор;
		Карта.Поле = Поле.Поле;
		Карта.Заголовок = Поле.Заголовок;
		Карта.Обязательное = Поле.Обязательное;
	КонецЦикла;
	Если Добавляемые.Количество() > 0 Тогда
		Форма.ИзменитьРеквизиты(Добавляемые);
	КонецЕсли;

	Для Каждого Карта Из Форма.ПоляФормы Цикл
		Элемент = ДобавитьПоле(Форма, Карта.Имя, Карта.Имя, Карта.Заголовок, Форма.Элементы.ПоляВида);
		Элемент.АвтоОтметкаНезаполненного = Карта.Обязательное;
		Элемент.УстановитьДействие("ПриИзменении", "ПолеВидаПриИзменении");
		Описание = Поля.Найти(Карта.Поле, "Поле");
		Если Описание.ТипПоля = Перечисления.ТипыПолей.ВыборИзСписка Тогда
			Параметры = Новый Массив;
			Параметры.Добавить(Новый ПараметрВыбора("Отбор.Владелец", Карта.Поле));
			Элемент.ПараметрыВыбора = Новый ФиксированныйМассив(Параметры);
			Элемент.ВыбиратьТип = Ложь;
		КонецЕсли;
		Для Каждого ЗначениеПоля Из Форма.Объект.ЗначенияПолей Цикл
			Если ЗначениеПоля.Поле = Карта.Поле Тогда
				Форма[Карта.Имя] = ЗначениеПоля.Значение;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Обновляются только видимые поля. Скрытые поля старых документов сохраняются.
Процедура ПеренестиЗначенияВОбъект(Форма) Экспорт
	Для Каждого Карта Из Форма.ПоляФормы Цикл
		Найденная = Неопределено;
		Для Каждого СтрокаЗначения Из Форма.Объект.ЗначенияПолей Цикл
			Если СтрокаЗначения.Поле = Карта.Поле Тогда
				Найденная = СтрокаЗначения;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Найденная = Неопределено Тогда
			Найденная = Форма.Объект.ЗначенияПолей.Добавить();
			Найденная.Поле = Карта.Поле;
		КонецЕсли;
		Найденная.Значение = Форма[Карта.Имя];
	КонецЦикла;
КонецПроцедуры

// Проверка формы возвращает тот же формат, что ядро: массив структур Поле, Текст.
Функция ОшибкиДокумента(Форма) Экспорт
	Ошибки = Новый Массив;
	Если Не ЗначениеЗаполнено(Форма.Категория) Тогда
		Ошибки.Добавить(Новый Структура("Поле,Текст", "Категория", "Выберите категорию документа"));
	КонецЕсли;
	Вид = Форма.Объект.ВидДокумента;
	Если Не ЗначениеЗаполнено(Вид) Тогда
		Ошибки.Добавить(Новый Структура("Поле,Текст", "ВидДокумента", "Выберите вид документа"));
	ИначеЕсли Не ЗначениеЗаполнено(Форма.Объект.Ссылка)
		И (Вид.Категория <> Форма.Категория
		Или Вид.СтатусНастройки <> Перечисления.СтатусыНастройкиВида.Готов
		Или Вид.ПометкаУдаления) Тогда
		Ошибки.Добавить(Новый Структура("Поле,Текст", "ВидДокумента", "Выберите готовый вид выбранной категории"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Форма.Объект.Ответственный) Тогда
		Ошибки.Добавить(Новый Структура("Поле,Текст", "Ответственный", "Заполните поле «Ответственный»"));
	КонецЕсли;
	Поля = КонструкторВидов.ПоляВида(Вид);
	Для Каждого Карта Из Форма.ПоляФормы Цикл
		Значение = Форма[Карта.Имя];
		Если Карта.Обязательное И Не ЗначениеЗаполнено(Значение) Тогда
			Ошибки.Добавить(Новый Структура("Поле,Текст", Карта.Идентификатор,
				СтрШаблон("Заполните поле «%1»", Карта.Заголовок)));
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Значение) Тогда
			Продолжить;
		КонецЕсли;
		Описание = Поля.Найти(Карта.Поле, "Поле");
		Текст = КонструкторВидов.ОшибкиФормата(Значение, Описание.ТипПоля, Карта.Поле.ТолькоПоложительное);
		Если Описание.ТипПоля = Перечисления.ТипыПолей.ВыборИзСписка Тогда
			Если Значение.Владелец <> Карта.Поле Или Значение.ПометкаУдаления Тогда
				Текст = "Выберите значение из списка этого поля";
			КонецЕсли;
		КонецЕсли;
		Если Не ПустаяСтрока(Текст) Тогда
			Ошибки.Добавить(Новый Структура("Поле,Текст", Карта.Идентификатор,
				СтрШаблон("Поле «%1»: %2", Карта.Заголовок, Текст)));
		КонецЕсли;
	КонецЦикла;
	Возврат Ошибки;
КонецФункции

Процедура ВывестиОшибки(Форма, Ошибки) Экспорт
	Для Каждого Ошибка Из Ошибки Цикл
		Путь = "";
		Если Ошибка.Поле = "Категория" Тогда
			Путь = "Категория";
		ИначеЕсли Не ПустаяСтрока(Ошибка.Поле) Тогда
			Путь = "Объект." + Ошибка.Поле;
		КонецЕсли;
		Для Каждого Карта Из Форма.ПоляФормы Цикл
			Если Карта.Идентификатор = Ошибка.Поле Или Карта.Имя = Ошибка.Поле Тогда
				Путь = Карта.Имя;
				Форма.Элементы[Карта.Имя].ОтметкаНезаполненного = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Ошибка.Текст;
		Сообщение.Поле = Путь;
		Сообщение.Сообщить();
	КонецЦикла;
КонецПроцедуры

Функция ДобавитьГруппу(Форма, Имя, Заголовок, Родитель = Неопределено) Экспорт
	Группа = Форма.Элементы.Добавить(Имя, Тип("ГруппаФормы"), Родитель);
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	Группа.Заголовок = Заголовок;
	Группа.ОтображатьЗаголовок = Не ПустаяСтрока(Заголовок);
	Возврат Группа;
КонецФункции

Функция ДобавитьПоле(Форма, Имя, Путь, Заголовок, Родитель = Неопределено) Экспорт
	Поле = Форма.Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = Путь;
	Поле.Заголовок = Заголовок;
	Возврат Поле;
КонецФункции

Процедура ДобавитьКнопку(Форма, Имя, Заголовок, Действие, Родитель = Неопределено) Экспорт
	Команда = Форма.Команды.Добавить(Имя);
	Команда.Заголовок = Заголовок;
	Команда.Действие = Действие;
	Кнопка = Форма.Элементы.Добавить(Имя, Тип("КнопкаФормы"), Родитель);
	Кнопка.ИмяКоманды = Имя;
КонецПроцедуры

Процедура НастроитьЦветаСтатуса(Оформление, ПутьСтатуса) Экспорт
	Для Каждого Статус Из Перечисления.СтатусыДокументов Цикл
		Элемент = Оформление.Элементы.Добавить();
		Поле = Элемент.Поля.Элементы.Добавить();
		Поле.Поле = Новый ПолеКомпоновкиДанных(ПутьСтатуса);
		Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьСтатуса);
		Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Отбор.ПравоеЗначение = Статус;
		Отбор.Использование = Истина;
		Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветСтатуса(Статус));
	КонецЦикла;
КонецПроцедуры

Функция ЦветСтатуса(Статус) Экспорт
	Если Статус = Перечисления.СтатусыДокументов.НаСогласовании Тогда
		Возврат ЦветаСтиля.СтатусНаСогласовании;
	ИначеЕсли Статус = Перечисления.СтатусыДокументов.Согласован Тогда
		Возврат ЦветаСтиля.СтатусСогласован;
	ИначеЕсли Статус = Перечисления.СтатусыДокументов.Отклонен Тогда
		Возврат ЦветаСтиля.СтатусОтклонен;
	ИначеЕсли Статус = Перечисления.СтатусыДокументов.НаДоработке Тогда
		Возврат ЦветаСтиля.СтатусНаДоработке;
	КонецЕсли;
	Возврат ЦветаСтиля.СтатусЧерновик;
КонецФункции

// Стадии определяются решениями снимка, а не сравнением номеров с текущим этапом.
// После возврата на доработку такая логика не показывает непройденные этапы зелёными.
Функция ТаймлайнHTML(Объект) Экспорт
	HTML = "<!doctype html><html lang='ru'><head><meta charset='utf-8'>"
		+ "<meta name='viewport' content='width=device-width,initial-scale=1'>"
		+ "<style>body{font:14px Roboto,Arial,sans-serif;margin:12px;overflow-wrap:break-word;background:"
		+ CSSЦвет(ЦветаСтиля.ФонТаймлайна) + "}ol{padding-left:24px}li{padding:6px 0}"
		+ "h3{font-size:16px}p{margin:0}</style></head><body>"
		+ "<h3>Маршрут согласования</h3><ol>";
	Таблица = Объект.МаршрутСнимок.Выгрузить();
	Таблица.Сортировать("НомерЭтапа");
	Для Каждого Этап Из Таблица Цикл
		Знак = "○";
		Состояние = "Ожидает";
		Цвет = ЦветаСтиля.СтатусЧерновик;
		Если Этап.Решение = Перечисления.РешенияСогласования.Согласовано Тогда
			Знак = "✓";
			Состояние = "Согласован";
			Цвет = ЦветаСтиля.СтатусСогласован;
		ИначеЕсли Этап.Решение = Перечисления.РешенияСогласования.Отклонено Тогда
			Знак = "✕";
			Состояние = "Отклонён";
			Цвет = ЦветаСтиля.СтатусОтклонен;
		ИначеЕсли Объект.Статус = Перечисления.СтатусыДокументов.НаСогласовании
			И Этап.НомерЭтапа = Объект.ТекущийЭтап Тогда
			Знак = "●";
			Состояние = "Текущий";
			Цвет = ЦветаСтиля.СтатусНаСогласовании;
		КонецЕсли;
		HTML = HTML + "<li style='color:" + CSSЦвет(Цвет) + "'><p><b>" + Знак + " " + ЭкранироватьHTML(Этап.НазваниеЭтапа)
			+ "</b> — " + ЭкранироватьHTML(Этап.Согласующий) + "<br>" + Состояние + "</p></li>";
	КонецЦикла;
	Если Таблица.Количество() = 0 Тогда
		HTML = HTML + "<li>Маршрут появится после отправки на согласование</li>";
	КонецЕсли;
	Возврат HTML + "</ol></body></html>";
КонецФункции

// Пока владельцы модулей не передали контракт, интерфейс не меняет статусы.
Функция ДоступныеДействия() Экспорт
	Возврат Новый Структура("Отправка,Решение,Печать,Причина", Ложь, Ложь, Ложь,
		"Согласование и печать пока недоступны в этой сборке.");
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция CSSЦвет(Цвет)
	Возврат "rgb(" + Формат(Цвет.Красный, "ЧГ=0") + ","
		+ Формат(Цвет.Зеленый, "ЧГ=0") + "," + Формат(Цвет.Синий, "ЧГ=0") + ")";
КонецФункции

Функция ЭкранироватьHTML(Значение)
	Текст = СтрЗаменить(Строка(Значение), "&", "&amp;");
	Текст = СтрЗаменить(Текст, "<", "&lt;");
	Текст = СтрЗаменить(Текст, ">", "&gt;");
	Текст = СтрЗаменить(Текст, "'", "&#39;");
	Возврат СтрЗаменить(Текст, Символ(34), "&quot;");
КонецФункции

#КонецОбласти
