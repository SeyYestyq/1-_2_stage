#Область ПрограммныйИнтерфейс

// Возвращает состав полей вида документа в порядке, заданном администратором.
// Скрытые поля в результат не попадают: данные старых документов сохраняются, но поле больше
// не выводится в форме и в печати.
//
// Параметры:
//  Вид - СправочникОбъект.ВидыДокументов, СправочникСсылка.ВидыДокументов - вид документа;
//        незаписанный объект тоже принимается (нужно для предпросмотра и проверки до записи).
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки: Поле, Заголовок, Идентификатор, ТипПоля, ТипЗначения,
//                    Обязательное, Порядок.
//
Функция ПоляВида(Вид) Экспорт

	Результат = НоваяТаблицаПолейВида();

	ОбъектВида = ОбъектВида(Вид);
	Если ОбъектВида = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого СтрокаПоля Из ОбъектВида.Поля Цикл

		Если СтрокаПоля.Скрыто = Истина Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаПоля.Поле = Неопределено Или СтрокаПоля.Поле.Пустая() Тогда
			Продолжить;
		КонецЕсли;

		СвойстваПоля = ОписаниеПоля(СтрокаПоля.Поле);
		Если СвойстваПоля = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Поле          = СтрокаПоля.Поле;
		НоваяСтрока.Идентификатор = СвойстваПоля.Идентификатор;
		НоваяСтрока.Заголовок     = СвойстваПоля.Заголовок;
		НоваяСтрока.ТипПоля       = СвойстваПоля.ТипПоля;
		НоваяСтрока.ТипЗначения   = ТипЗначенияПоля(СвойстваПоля.ТипПоля);
		НоваяСтрока.Обязательное  = СтрокаПоля.Обязательное;
		НоваяСтрока.Порядок       = СтрокаПоля.Порядок;

	КонецЦикла;

	Результат.Сортировать("Порядок Возр, Заголовок Возр");

	Возврат Результат;

КонецФункции

// Возвращает виды документов, которые можно предлагать пользователю при создании документа.
//
// Параметры:
//  Категория - ПеречислениеСсылка.КатегорииДокументов, Неопределено - отбор по категории;
//              Неопределено - все категории.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки: Вид, Наименование, Категория.
//
Функция ВидыДляСоздания(Категория = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВидыДокументов.Ссылка КАК Вид,
		|	ВидыДокументов.Наименование КАК Наименование,
		|	ВидыДокументов.Категория КАК Категория
		|ИЗ
		|	Справочник.ВидыДокументов КАК ВидыДокументов
		|ГДЕ
		|	ВидыДокументов.ПометкаУдаления = ЛОЖЬ
		|	И ВидыДокументов.СтатусНастройки = ЗНАЧЕНИЕ(Перечисление.СтатусыНастройкиВида.Готов)";

	Если Категория <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + "
			|	И ВидыДокументов.Категория = &Категория";
		Запрос.УстановитьПараметр("Категория", Категория);
	КонецЕсли;

	Запрос.Текст = Запрос.Текст + "
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Проверяет шаблон вида документа и возвращает все найденные ошибки сразу.
//
// Параметры:
//  Вид - СправочникОбъект.ВидыДокументов - вид документа, в том числе незаписанный.
//
// Возвращаемое значение:
//  Массив - структуры с ключами Поле (Строка) и Текст (Строка); пустой массив - ошибок нет.
//
Функция ПроверитьШаблон(Вид) Экспорт

	Ошибки = Новый Массив;

	ОбъектВида = ОбъектВида(Вид);
	Если ОбъектВида = Неопределено Тогда
		ДобавитьОшибку(Ошибки, "Объект", "Вид документа не передан.");
		Возврат Ошибки;
	КонецЕсли;

	Если ПустаяСтрока(ОбъектВида.Наименование) Тогда
		ДобавитьОшибку(Ошибки, "Наименование", "Не задано наименование вида документа.");
	КонецЕсли;

	Если ОбъектВида.Категория = Неопределено Или ОбъектВида.Категория.Пустая() Тогда
		ДобавитьОшибку(Ошибки, "Категория", "Не выбрана категория документа.");
	КонецЕсли;

	ОшибкиПолей = ПроверитьПоляВида(ОбъектВида);
	Для Каждого Ошибка Из ОшибкиПолей Цикл
		Ошибки.Добавить(Ошибка);
	КонецЦикла;

	ОшибкиМаршрута = ПроверитьМаршрутВида(ОбъектВида);
	Для Каждого Ошибка Из ОшибкиМаршрута Цикл
		Ошибки.Добавить(Ошибка);
	КонецЦикла;

	Возврат Ошибки;

КонецФункции

// Проверяет шаблон и, если ошибок нет, сохраняет вид в транзакции со статусом «Готов».
// Если ошибки есть, вид остаётся «Черновик» и не записывается.
//
// Параметры:
//  Вид - СправочникОбъект.ВидыДокументов - вид документа.
//
// Возвращаемое значение:
//  Массив - структуры {Поле, Текст}; пустой массив - шаблон сохранён и готов к использованию.
//
Функция ПроверитьИСохранитьШаблон(Вид) Экспорт

	Ошибки = ПроверитьШаблон(Вид);
	ОбъектВида = ОбъектВида(Вид);
	Если ОбъектВида = Неопределено Тогда
		Возврат Ошибки;
	КонецЕсли;

	Если Ошибки.Количество() > 0 Тогда
		ОбъектВида.СтатусНастройки = Перечисления.СтатусыНастройкиВида.Черновик;
		Возврат Ошибки;
	КонецЕсли;

	ОбъектВида.СтатусНастройки = Перечисления.СтатусыНастройкиВида.Готов;

	НачатьТранзакцию();
	Попытка
		ОбъектВида.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Ошибки;

КонецФункции

// Проверяет значение поля по правилам типа поля. Используется проверкой заполнения документа.
//
// Параметры:
//  Значение             - Произвольный - значение поля документа;
//  ТипПоля              - ПеречислениеСсылка.ТипыПолей - тип поля вида;
//  ТолькоПоложительное  - Булево - для чисел: значение не должно быть меньше нуля.
//
// Возвращаемое значение:
//  Строка - текст ошибки; пустая строка - значение корректно.
//
Функция ОшибкиФормата(Значение, ТипПоля, ТолькоПоложительное = Ложь) Экспорт

	Если ТипПоля = Неопределено Или ТипПоля.Пустая() Тогда
		Возврат "Не задан тип поля.";
	КонецЕсли;

	Если ТипПоля = Перечисления.ТипыПолей.Число Тогда
		Если ТипЗнч(Значение) <> Тип("Число") Тогда
			Возврат "Ожидается число.";
		КонецЕсли;
		Если ТолькоПоложительное = Истина И Значение < 0 Тогда
			Возврат "Значение не может быть отрицательным.";
		КонецЕсли;
		Возврат "";
	КонецЕсли;

	Если ТипПоля = Перечисления.ТипыПолей.Дата Тогда
		Если ТипЗнч(Значение) <> Тип("Дата") Тогда
			Возврат "Ожидается дата.";
		КонецЕсли;
		Если Значение = '00010101' Тогда
			Возврат "Дата не заполнена.";
		КонецЕсли;
		Возврат "";
	КонецЕсли;

	Если ТипПоля = Перечисления.ТипыПолей.Строка Тогда
		Если ТипЗнч(Значение) <> Тип("Строка") Тогда
			Возврат "Ожидается строка.";
		КонецЕсли;
		Возврат "";
	КонецЕсли;

	Если ТипПоля = Перечисления.ТипыПолей.ВыборИзСписка Тогда
		Если Значение = Неопределено Или Значение = Null Тогда
			Возврат "Значение не выбрано.";
		КонецЕсли;
		Возврат "";
	КонецЕсли;

	Возврат "";

КонецФункции

// Выгружает настройку вида в JSON, чтобы перенести вид в другую базу без Конфигуратора.
//
// Параметры:
//  Вид - СправочникОбъект.ВидыДокументов, СправочникСсылка.ВидыДокументов - вид документа.
//
// Возвращаемое значение:
//  Строка - JSON настройки вида; пустая строка, если вид не передан.
//
Функция ВыгрузитьВидВJSON(Вид) Экспорт

	ОбъектВида = ОбъектВида(Вид);
	Если ОбъектВида = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("Версия",       1);
	Данные.Вставить("Наименование", ОбъектВида.Наименование);
	Данные.Вставить("Префикс",      ОбъектВида.Префикс);
	Данные.Вставить("Описание",     ОбъектВида.Описание);
	Данные.Вставить("Категория",    ЗначениеПеречисления(ОбъектВида.Категория));

	Поля = Новый Массив;
	Для Каждого СтрокаПоля Из ОбъектВида.Поля Цикл

		Если СтрокаПоля.Поле = Неопределено Или СтрокаПоля.Поле.Пустая() Тогда
			Продолжить;
		КонецЕсли;

		СвойстваПоля = ОписаниеПоля(СтрокаПоля.Поле);
		Если СвойстваПоля = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Поле = Новый Структура;
		Поле.Вставить("Идентификатор",        СвойстваПоля.Идентификатор);
		Поле.Вставить("Заголовок",            СвойстваПоля.Заголовок);
		Поле.Вставить("ТипПоля",              ЗначениеПеречисления(СвойстваПоля.ТипПоля));
		Поле.Вставить("ТолькоПоложительное",  СвойстваПоля.ТолькоПоложительное);
		Поле.Вставить("Обязательное",         СтрокаПоля.Обязательное);
		Поле.Вставить("Скрыто",               СтрокаПоля.Скрыто);
		Поле.Вставить("Порядок",              СтрокаПоля.Порядок);
		Поле.Вставить("Значения",             ЗначенияПоляВМассив(СтрокаПоля.Поле));
		Поля.Добавить(Поле);

	КонецЦикла;
	Данные.Вставить("Поля", Поля);

	Маршрут = Новый Массив;
	Для Каждого СтрокаЭтапа Из ОбъектВида.Маршрут Цикл

		Этап = Новый Структура;
		Этап.Вставить("НомерЭтапа",     СтрокаЭтапа.НомерЭтапа);
		Этап.Вставить("НазваниеЭтапа",  СтрокаЭтапа.НазваниеЭтапа);
		Этап.Вставить("СрокЭтапа",      СтрокаЭтапа.СрокЭтапа);
		Этап.Вставить("Согласующий",    ОписаниеСогласующего(СтрокаЭтапа.Согласующий));
		Маршрут.Добавить(Этап);

	КонецЦикла;
	Данные.Вставить("Маршрут", Маршрут);

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);

	Возврат Запись.Закрыть();

КонецФункции

// Создаёт новый вид документа из JSON, полученного функцией ВыгрузитьВидВJSON.
// Создаётся всегда новый вид; совпадение наименований не проверяется — решает администратор.
//
// Параметры:
//  ТекстJSON - Строка - JSON настройки вида.
//
// Возвращаемое значение:
//  СправочникСсылка.ВидыДокументов - созданный вид; пустая ссылка, если загрузить не удалось
//                                     (текст ошибки передаётся через исключение).
//
Функция ЗагрузитьВидИзJSON(ТекстJSON) Экспорт

	Если ПустаяСтрока(ТекстJSON) Тогда
		ВызватьИсключение "Пустой JSON настройки вида.";
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Данные = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();

	Если ТипЗнч(Данные) <> Тип("Структура") Или Не Данные.Свойство("Наименование") Тогда
		ВызватьИсключение "JSON не похож на настройку вида документа: нет ключа «Наименование».";
	КонецЕсли;

	НовыйВид = Справочники.ВидыДокументов.СоздатьЭлемент();
	НовыйВид.Наименование = Данные.Наименование;
	НовыйВид.Префикс      = ЗначениеИзJSON(Данные, "Префикс", "");
	НовыйВид.Описание     = ЗначениеИзJSON(Данные, "Описание", "");
	НовыйВид.Категория    = ПеречислениеИзСтроки(Данные, "Категория", "КатегорииДокументов");
	НовыйВид.СтатусНастройки = Перечисления.СтатусыНастройкиВида.Черновик;
	НовыйВид.Записать();

	// Поля создаются после записи вида: у элемента ПВХ владелец — уже записанный вид.
	Если Данные.Свойство("Поля") И ТипЗнч(Данные.Поля) = Тип("Массив") Тогда
		Для Каждого ОписаниеПоляJSON Из Данные.Поля Цикл
			СоздатьПолеВида(НовыйВид.Ссылка, ОписаниеПоляJSON);
		КонецЦикла;
	КонецЕсли;

	Если Данные.Свойство("Маршрут") И ТипЗнч(Данные.Маршрут) = Тип("Массив") Тогда
		ЗаполнитьМаршрутИзJSON(НовыйВид, Данные.Маршрут);
		НовыйВид.Записать();
	КонецЕсли;

	Ошибки = ПроверитьШаблон(НовыйВид);
	Если Ошибки.Количество() > 0 Тогда
		НовыйВид.СтатусНастройки = Перечисления.СтатусыНастройкиВида.Черновик;
		НовыйВид.Записать();
	КонецЕсли;

	Возврат НовыйВид.Ссылка;

КонецФункции

// Создаёт копию вида документа: поля, значения списков и маршрут переносятся полностью.
// Копия получает статус «Черновик» и проходит проверку шаблона.
//
// Параметры:
//  Вид                - СправочникСсылка.ВидыДокументов - копируемый вид;
//  НовоеНаименование  - Строка - наименование копии; пустая строка - «<исходное> (копия)».
//
// Возвращаемое значение:
//  СправочникСсылка.ВидыДокументов - созданная копия.
//
Функция СкопироватьВид(Вид, НовоеНаименование = "") Экспорт

	ИсходныйВид = ОбъектВида(Вид);
	Если ИсходныйВид = Неопределено Тогда
		ВызватьИсключение "Вид документа не передан.";
	КонецЕсли;

	Если ПустаяСтрока(НовоеНаименование) Тогда
		НовоеНаименование = ИсходныйВид.Наименование + " (копия)";
	КонецЕсли;

	Копия = Справочники.ВидыДокументов.СоздатьЭлемент();
	Копия.Наименование    = НовоеНаименование;
	Копия.Категория       = ИсходныйВид.Категория;
	Копия.Префикс         = ИсходныйВид.Префикс;
	Копия.Описание        = ИсходныйВид.Описание;
	Копия.СтатусНастройки = Перечисления.СтатусыНастройкиВида.Черновик;
	Копия.Записать();

	Для Каждого СтрокаПоля Из ИсходныйВид.Поля Цикл

		Если СтрокаПоля.Поле = Неопределено Или СтрокаПоля.Поле.Пустая() Тогда
			Продолжить;
		КонецЕсли;

		СвойстваПоля = ОписаниеПоля(СтрокаПоля.Поле);
		Если СвойстваПоля = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ОписаниеПоляJSON = Новый Структура;
		ОписаниеПоляJSON.Вставить("Идентификатор",       СвойстваПоля.Идентификатор);
		ОписаниеПоляJSON.Вставить("Заголовок",           СвойстваПоля.Заголовок);
		ОписаниеПоляJSON.Вставить("ТипПоля",             ЗначениеПеречисления(СвойстваПоля.ТипПоля));
		ОписаниеПоляJSON.Вставить("ТолькоПоложительное", СвойстваПоля.ТолькоПоложительное);
		ОписаниеПоляJSON.Вставить("Обязательное",        СтрокаПоля.Обязательное);
		ОписаниеПоляJSON.Вставить("Скрыто",              СтрокаПоля.Скрыто);
		ОписаниеПоляJSON.Вставить("Порядок",             СтрокаПоля.Порядок);
		ОписаниеПоляJSON.Вставить("Значения",            ЗначенияПоляВМассив(СтрокаПоля.Поле));

		СоздатьПолеВида(Копия.Ссылка, ОписаниеПоляJSON);

	КонецЦикла;

	Для Каждого СтрокаЭтапа Из ИсходныйВид.Маршрут Цикл
		НоваяСтрока = Копия.Маршрут.Добавить();
		НоваяСтрока.НомерЭтапа    = СтрокаЭтапа.НомерЭтапа;
		НоваяСтрока.НазваниеЭтапа = СтрокаЭтапа.НазваниеЭтапа;
		НоваяСтрока.Согласующий   = СтрокаЭтапа.Согласующий;
		НоваяСтрока.СрокЭтапа     = СтрокаЭтапа.СрокЭтапа;
	КонецЦикла;

	Копия.Записать();

	Возврат Копия.Ссылка;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НоваяТаблицаПолейВида()

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Поле",          Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ПоляДокументов"));
	Результат.Колонки.Добавить("Заголовок",     Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	Результат.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	Результат.Колонки.Добавить("ТипПоля",       Новый ОписаниеТипов("ПеречислениеСсылка.ТипыПолей"));
	Результат.Колонки.Добавить("ТипЗначения",   Новый ОписаниеТипов("Тип"));
	Результат.Колонки.Добавить("Обязательное",  Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("Порядок",       Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(5, 0)));

	Возврат Результат;

КонецФункции

// Приводит переданное значение к объекту вида: ссылка читается, объект возвращается как есть,
// незаписанный объект принимается. Для пустых значений возвращается Неопределено.
Функция ОбъектВида(Вид)

	Если Вид = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(Вид) = Тип("СправочникОбъект.ВидыДокументов") Тогда
		Возврат Вид;
	КонецЕсли;

	Если ТипЗнч(Вид) = Тип("СправочникСсылка.ВидыДокументов") Тогда
		Если Вид.Пустая() Тогда
			Возврат Неопределено;
		КонецЕсли;
		Объект = Вид.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Объект;
	КонецЕсли;

	Если ТипЗнч(Вид) = Тип("Структура") И Вид.Свойство("Объект") Тогда
		Возврат Вид.Объект;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Возвращает описание поля вида из плана видов характеристик.
Функция ОписаниеПоля(Поле)

	ОбъектПоля = Поле.ПолучитьОбъект();
	Если ОбъектПоля = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Описание = Новый Структура;
	Описание.Вставить("Идентификатор",       ОбъектПоля.Наименование);
	Описание.Вставить("Заголовок",           ?(ПустаяСтрока(ОбъектПоля.Заголовок), ОбъектПоля.Наименование, ОбъектПоля.Заголовок));
	Описание.Вставить("ТипПоля",             ОбъектПоля.ТипПоля);
	Описание.Вставить("ТолькоПоложительное", ОбъектПоля.ТолькоПоложительное);

	Возврат Описание;

КонецФункции

Функция ТипЗначенияПоля(ТипПоля)

	Если ТипПоля = Перечисления.ТипыПолей.Строка Тогда
		Возврат Тип("Строка");
	ИначеЕсли ТипПоля = Перечисления.ТипыПолей.Число Тогда
		Возврат Тип("Число");
	ИначеЕсли ТипПоля = Перечисления.ТипыПолей.Дата Тогда
		Возврат Тип("Дата");
	ИначеЕсли ТипПоля = Перечисления.ТипыПолей.ВыборИзСписка Тогда
		Возврат Тип("СправочникСсылка.ЗначенияПолей");
	КонецЕсли;

	Возврат Тип("Строка");

КонецФункции

Процедура ДобавитьОшибку(Ошибки, Поле, Текст)

	Описание = Новый Структура("Поле, Текст", Поле, Текст);
	Ошибки.Добавить(Описание);

КонецПроцедуры

// Проверяет состав полей: наличие, повтор идентификаторов, значения списков, осмысленность флага.
Функция ПроверитьПоляВида(ОбъектВида)

	Ошибки = Новый Массив;

	ВидимыхПолей = 0;
	Идентификаторы = Новый Соответствие;
	ПоляБезСписка = Новый Массив;
	ПоляВыбораИзСписка = Новый Массив;

	Для Каждого СтрокаПоля Из ОбъектВида.Поля Цикл

		Если СтрокаПоля.Скрыто = Истина Тогда
			Продолжить;
		КонецЕсли;

		ВидимыхПолей = ВидимыхПолей + 1;

		Если СтрокаПоля.Поле = Неопределено Или СтрокаПоля.Поле.Пустая() Тогда
			ДобавитьОшибку(Ошибки, "Поля", "В строке полей не выбрано поле.");
			Продолжить;
		КонецЕсли;

		СвойстваПоля = ОписаниеПоля(СтрокаПоля.Поле);
		Если СвойстваПоля = Неопределено Тогда
			ДобавитьОшибку(Ошибки, "Поля", "Поле не найдено в плане видов характеристик.");
			Продолжить;
		КонецЕсли;

		Идентификатор = СвойстваПоля.Идентификатор;

		Если Идентификаторы.Получить(Идентификатор) <> Неопределено Тогда
			ДобавитьОшибку(Ошибки, "Поля",
				СтрШаблон("Поле «%1» указано в виде больше одного раза.", Идентификатор));
		Иначе
			Идентификаторы.Вставить(Идентификатор, Истина);
		КонецЕсли;

		Если СвойстваПоля.ТипПоля = Перечисления.ТипыПолей.ВыборИзСписка Тогда
			ПоляВыбораИзСписка.Добавить(СтрокаПоля.Поле);
		КонецЕсли;

		Если СвойстваПоля.ТолькоПоложительное = Истина
			И СвойстваПоля.ТипПоля <> Перечисления.ТипыПолей.Число Тогда
			ДобавитьОшибку(Ошибки, "Поля",
				СтрШаблон("У поля «%1» стоит признак «Только положительное», но тип поля — не число.",
					Идентификатор));
		КонецЕсли;

	КонецЦикла;

	Если ВидимыхПолей = 0 Тогда
		ДобавитьОшибку(Ошибки, "Поля", "В виде нет ни одного поля.");
	КонецЕсли;

	// Значения списков проверяются одним запросом, без обращения к базе в цикле.
	Если ПоляВыбораИзСписка.Количество() > 0 Тогда

		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ЗначенияПолей.Владелец КАК Поле,
			|	КОЛИЧЕСТВО(*) КАК Всего
			|ИЗ
			|	Справочник.ЗначенияПолей КАК ЗначенияПолей
			|ГДЕ
			|	ЗначенияПолей.Владелец В (&Поля)
			|	И ЗначенияПолей.ПометкаУдаления = ЛОЖЬ
			|
			|СГРУППИРОВАТЬ ПО
			|	ЗначенияПолей.Владелец";
		Запрос.УстановитьПараметр("Поля", ПоляВыбораИзСписка);

		Выборка = Запрос.Выполнить().Выбрать();
		КоличествоЗначений = Новый Соответствие;
		Пока Выборка.Следующий() Цикл
			КоличествоЗначений.Вставить(Выборка.Поле, Выборка.Всего);
		КонецЦикла;

		Для Каждого ПолеСписка Из ПоляВыбораИзСписка Цикл

			Всего = КоличествоЗначений.Получить(ПолеСписка);
			Если Всего = Неопределено Тогда
				Всего = 0;
			КонецЕсли;

			Если Всего < 2 Тогда
				СвойстваПоля = ОписаниеПоля(ПолеСписка);
				ДобавитьОшибку(Ошибки, "Поля",
					СтрШаблон("Для поля «%1» нужно не меньше двух значений списка (сейчас %2).",
						СвойстваПоля.Идентификатор, Всего));
			КонецЕсли;

		КонецЦикла;

	КонецЕсли;

	Возврат Ошибки;

КонецФункции

// Проверяет маршрут: не меньше двух этапов, у каждого есть согласующий,
// не меньше двух разных сотрудников, никто не идёт два этапа подряд.
Функция ПроверитьМаршрутВида(ОбъектВида)

	Ошибки = Новый Массив;

	Если ОбъектВида.Маршрут.Количество() < 2 Тогда
		ДобавитьОшибку(Ошибки, "Маршрут",
			"В маршруте меньше двух этапов согласования.");
	КонецЕсли;

	Сотрудники = Новый Массив;
	ПредыдущийСогласующий = Неопределено;
	НомерСтроки = 0;

	Для Каждого СтрокаЭтапа Из ОбъектВида.Маршрут Цикл

		НомерСтроки = НомерСтроки + 1;

		Если СтрокаЭтапа.Согласующий = Неопределено Или СтрокаЭтапа.Согласующий.Пустая() Тогда
			ДобавитьОшибку(Ошибки, "Маршрут",
				СтрШаблон("В этапе №%1 не указан согласующий.", НомерСтроки));
			Продолжить;
		КонецЕсли;

		Если ПредыдущийСогласующий <> Неопределено
			И ПредыдущийСогласующий = СтрокаЭтапа.Согласующий Тогда
			ДобавитьОшибку(Ошибки, "Маршрут",
				СтрШаблон("Сотрудник «%1» стоит согласующим два этапа подряд (этапы %2 и %3).",
					СтрокаЭтапа.Согласующий, НомерСтроки - 1, НомерСтроки));
		КонецЕсли;

		ПредыдущийСогласующий = СтрокаЭтапа.Согласующий;

		Если Сотрудники.Найти(СтрокаЭтапа.Согласующий) = Неопределено Тогда
			Сотрудники.Добавить(СтрокаЭтапа.Согласующий);
		КонецЕсли;

	КонецЦикла;

	Если ОбъектВида.Маршрут.Количество() > 0 И Сотрудники.Количество() < 2 Тогда
		ДобавитьОшибку(Ошибки, "Маршрут",
			"В маршруте должен быть не меньше двух разных согласующих сотрудников.");
	КонецЕсли;

	Возврат Ошибки;

КонецФункции

Функция ЗначенияПоляВМассив(Поле)

	Результат = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗначенияПолей.Ссылка КАК Ссылка,
		|	ЗначенияПолей.Наименование КАК Наименование,
		|	ЗначенияПолей.Порядок КАК Порядок
		|ИЗ
		|	Справочник.ЗначенияПолей КАК ЗначенияПолей
		|ГДЕ
		|	ЗначенияПолей.Владелец = &Поле
		|	И ЗначенияПолей.ПометкаУдаления = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок, Наименование";
	Запрос.УстановитьПараметр("Поле", Поле);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Описание = Новый Структура("Наименование, Порядок", Выборка.Наименование, Выборка.Порядок);
		Результат.Добавить(Описание);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ОписаниеСогласующего(Согласующий)

	Если Согласующий = Неопределено Или Согласующий.Пустая() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Описание = Новый Структура;
	Описание.Вставить("Наименование", Согласующий.Наименование);
	Описание.Вставить("Email",        Согласующий.Email);

	Возврат Описание;

КонецФункции

Функция ЗначениеПеречисления(Значение)

	Если Значение = Неопределено Или Значение.Пустая() Тогда
		Возврат "";
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

Функция ЗначениеИзJSON(Данные, Ключ, ЗначениеПоУмолчанию)

	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство(Ключ) Тогда
		Если ТипЗнч(Данные[Ключ]) = Тип("Строка") Тогда
			Возврат Данные[Ключ];
		КонецЕсли;
		Если ТипЗнч(Данные[Ключ]) = Тип("Число") Тогда
			Возврат Формат(Данные[Ключ], "ЧГ=0");
		КонецЕсли;
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

Функция ПеречислениеИзСтроки(Данные, Ключ, ИмяПеречисления)

	Значение = ЗначениеИзJSON(Данные, Ключ, "");
	Если ПустаяСтрока(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Выражение = "Перечисления." + ИмяПеречисления + "." + Значение;
		Результат = Вычислить(Выражение);
		Возврат Результат;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Создаёт элемент плана видов характеристик с владельцем-видом и значениями,
// затем строку в табличной части «Поля» вида.
Процедура СоздатьПолеВида(ВидСсылка, ОписаниеПоляJSON)

	Идентификатор = ЗначениеИзJSON(ОписаниеПоляJSON, "Идентификатор", "");
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	ОбъектВида = ВидСсылка.ПолучитьОбъект();
	Если ОбъектВида = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НовоеПоле = ПланыВидовХарактеристик.ПоляДокументов.СоздатьЭлемент();
	НовоеПоле.Наименование            = Идентификатор;
	НовоеПоле.ВидДокумента            = ВидСсылка;
	НовоеПоле.Заголовок               = ЗначениеИзJSON(ОписаниеПоляJSON, "Заголовок", Идентификатор);
	НовоеПоле.ТипПоля                 = ПеречислениеИзСтроки(ОписаниеПоляJSON, "ТипПоля", "ТипыПолей");
	НовоеПоле.ТолькоПоложительное     = ?(ОписаниеПоляJSON.Свойство("ТолькоПоложительное"), ОписаниеПоляJSON.ТолькоПоложительное, Ложь);
	НовоеПоле.Записать();

	Если ОписаниеПоляJSON.Свойство("Значения") И ТипЗнч(ОписаниеПоляJSON.Значения) = Тип("Массив") Тогда
		Порядок = 0;
		Для Каждого ОписаниеЗначения Из ОписаниеПоляJSON.Значения Цикл
			Порядок = Порядок + 1;
			НовоеЗначение = Справочники.ЗначенияПолей.СоздатьЭлемент();
			НовоеЗначение.Владелец      = НовоеПоле.Ссылка;
			НовоеЗначение.Наименование  = ЗначениеИзJSON(ОписаниеЗначения, "Наименование", "");
			НовоеЗначение.Порядок       = Порядок;
			НовоеЗначение.Записать();
		КонецЦикла;
	КонецЕсли;

	НоваяСтрока = ОбъектВида.Поля.Добавить();
	НоваяСтрока.Поле          = НовоеПоле.Ссылка;
	НоваяСтрока.Порядок       = ?(ОписаниеПоляJSON.Свойство("Порядок"), ОписаниеПоляJSON.Порядок, ОбъектВида.Поля.Количество());
	НоваяСтрока.Обязательное  = ?(ОписаниеПоляJSON.Свойство("Обязательное"), ОписаниеПоляJSON.Обязательное, Ложь);
	НоваяСтрока.Скрыто        = ?(ОписаниеПоляJSON.Свойство("Скрыто"), ОписаниеПоляJSON.Скрыто, Ложь);
	ОбъектВида.Записать();

КонецПроцедуры

Процедура ЗаполнитьМаршрутИзJSON(ОбъектВида, ЭлементыМаршрута)

	ОбъектВида.Маршрут.Очистить();
	Номер = 0;

	Для Каждого ОписаниеЭтапа Из ЭлементыМаршрута Цикл

		Номер = Номер + 1;
		НоваяСтрока = ОбъектВида.Маршрут.Добавить();
		НоваяСтрока.НомерЭтапа    = ?(ОписаниеЭтапа.Свойство("НомерЭтапа"), ОписаниеЭтапа.НомерЭтапа, Номер);
		НоваяСтрока.НазваниеЭтапа = ЗначениеИзJSON(ОписаниеЭтапа, "НазваниеЭтапа", "");
		НоваяСтрока.СрокЭтапа     = ?(ОписаниеЭтапа.Свойство("СрокЭтапа"), ОписаниеЭтапа.СрокЭтапа, 0);
		НоваяСтрока.Согласующий   = СотрудникПоОписаниюИзJSON(ОписаниеЭтапа);

	КонецЦикла;

КонецПроцедуры

Функция СотрудникПоОписаниюИзJSON(ОписаниеЭтапа)

	Если Не ОписаниеЭтапа.Свойство("Согласующий") Тогда
		Возврат Справочники.Сотрудники.ПустаяСсылка();
	КонецЕсли;

	ОписаниеСотрудника = ОписаниеЭтапа.Согласующий;
	Если ОписаниеСотрудника = Неопределено Тогда
		Возврат Справочники.Сотрудники.ПустаяСсылка();
	КонецЕсли;

	Наименование = ЗначениеИзJSON(ОписаниеСотрудника, "Наименование", "");
	Если ПустаяСтрока(Наименование) Тогда
		Возврат Справочники.Сотрудники.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Сотрудники.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|ГДЕ
		|	Сотрудники.Наименование = &Наименование
		|	И Сотрудники.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("Наименование", Наименование);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.Сотрудники.ПустаяСсылка();

КонецФункции

#КонецОбласти
