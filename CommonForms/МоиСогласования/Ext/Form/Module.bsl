#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ДинамическиеФормы.ДобавитьПоле(ЭтотОбъект, "Пояснение", "Пояснение", "", Неопределено).ТолькоПросмотр = Истина;
	ДинамическиеФормы.ДобавитьКнопку(ЭтотОбъект, "Обновить", "Обновить", "Обновить");
	Таблица = Элементы.Добавить("Документы", Тип("ТаблицаФормы"));
	Таблица.ПутьКДанным = "Документы";
	Таблица.ТолькоПросмотр = Истина;
	Таблица.УстановитьДействие("Выбор", "ДокументыВыбор");
	Для Каждого Имя Из СтрРазделить("Номер,Дата,ВидДокумента,Ответственный,Статус,ТекущийЭтап", ",") Цикл
		ДинамическиеФормы.ДобавитьПоле(ЭтотОбъект, "Документы" + Имя, "Документы." + Имя, Имя, Таблица);
	КонецЦикла;
	Элементы.ДокументыВидДокумента.Заголовок = "Вид документа";
	Элементы.ДокументыТекущийЭтап.Заголовок = "Текущий этап";
	ДинамическиеФормы.НастроитьЦветаСтатуса(УсловноеОформление, "Документы.Статус");
	ОбновитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	ОбновитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДокументыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	СтрокаДокумента = Элемент.ТекущиеДанные;
	Если СтрокаДокумента <> Неопределено Тогда
		ОткрытьФорму("Документ.ДокументСЭД.ФормаОбъекта", Новый Структура("Ключ", СтрокаДокумента.Ссылка), ЭтаФорма);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьНаСервере()
	Документы.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Ссылка ИЗ Справочник.Сотрудники
		|ГДЕ Пользователь = &Пользователь И НЕ ПометкаУдаления";
	Запрос.УстановитьПараметр("Пользователь", ИмяПользователя());
	Сотрудники = Запрос.Выполнить().Выгрузить();
	Если Сотрудники.Количество() <> 1 Тогда
		Пояснение = "Для текущего пользователя нужна единственная привязка в справочнике «Сотрудники». Обратитесь к администратору.";
		Возврат;
	КонецЕсли;
	Запрос.Текст = "ВЫБРАТЬ Ссылка, Номер, Дата, ВидДокумента, Ответственный, Статус, ТекущийЭтап
		|ИЗ Документ.ДокументСЭД
		|ГДЕ ТекущийСогласующий = &Сотрудник
		|И Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.НаСогласовании)
		|И НЕ ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО Дата";
	Запрос.УстановитьПараметр("Сотрудник", Сотрудники[0].Ссылка);
	ЗначениеВРеквизитФормы(Запрос.Выполнить().Выгрузить(), "Документы");
	Пояснение = СтрШаблон("Ожидают вашего решения: %1. Откройте документ двойным щелчком.", Документы.Количество());
КонецПроцедуры

#КонецОбласти
