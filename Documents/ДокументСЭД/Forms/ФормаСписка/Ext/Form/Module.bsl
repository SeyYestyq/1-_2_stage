#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Отборы = ДинамическиеФормы.ДобавитьГруппу(ЭтотОбъект, "БыстрыеОтборы", "Быстрые отборы");
	Для Каждого Имя Из СтрРазделить("Категория,ВидДокумента,Ответственный,Статус", ",") Цикл
		Поле = ДинамическиеФормы.ДобавитьПоле(ЭтотОбъект, "Отбор" + Имя, "Отбор" + Имя, Имя, Отборы);
		Поле.УстановитьДействие("ПриИзменении", "БыстрыйОтборПриИзменении");
	КонецЦикла;
	Элементы.ОтборВидДокумента.Заголовок = "Вид документа";
	Элементы.Переместить(Отборы, , Элементы.Список);
	ДинамическиеФормы.ДобавитьКнопку(ЭтотОбъект, "СброситьОтборы", "Сбросить отборы", "СброситьОтборы", Отборы);
	ДинамическиеФормы.НастроитьЦветаСтатуса(Список.УсловноеОформление, "Статус");
	ДинамическиеФормы.ДобавитьПоле(ЭтотОбъект, "КатегорияСписка", "Список.ВидДокумента.Категория", "Категория", Элементы.Список);
	ДинамическиеФормы.ДобавитьПоле(ЭтотОбъект, "ТекущийЭтап", "Список.ТекущийЭтап", "Текущий этап", Элементы.Список);
	ДинамическиеФормы.ДобавитьПоле(ЭтотОбъект, "ТекущийСогласующий", "Список.ТекущийСогласующий", "Текущий согласующий", Элементы.Список);
	Элементы.СписокКоманднаяПанель.Автозаполнение = Истина;
	ДинамическиеФормы.ДобавитьКнопку(ЭтотОбъект, "МоиСогласования", "Мои согласования", "МоиСогласования", Отборы);
	ПрименитьБыстрыеОтборы();
КонецПроцедуры

&НаКлиенте
Процедура МоиСогласования(Команда)
	ОткрытьФорму("ОбщаяФорма.МоиСогласования");
КонецПроцедуры

&НаКлиенте
Процедура БыстрыйОтборПриИзменении(Элемент)
	ПрименитьБыстрыеОтборы();
КонецПроцедуры

&НаКлиенте
Процедура СброситьОтборы(Команда)
	ОтборКатегория = Неопределено;
	ОтборВидДокумента = Неопределено;
	ОтборОтветственный = Неопределено;
	ОтборСтатус = Неопределено;
	ПрименитьБыстрыеОтборы();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПрименитьБыстрыеОтборы()
	// Служебная группа живёт в фиксированных настройках. Пользовательский отбор
	// не очищается; четыре условия внутри группы соединены через И.
	Отбор = Список.КомпоновщикНастроек.ФиксированныеНастройки.Отбор;
	Отбор.Элементы.Очистить();
	ДобавитьОтбор(Отбор, "ВидДокумента.Категория", ОтборКатегория);
	ДобавитьОтбор(Отбор, "ВидДокумента", ОтборВидДокумента);
	ДобавитьОтбор(Отбор, "Ответственный", ОтборОтветственный);
	ДобавитьОтбор(Отбор, "Статус", ОтборСтатус);
КонецПроцедуры

&НаСервере
Процедура ДобавитьОтбор(Отбор, Имя, Значение)
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;
	Элемент = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Имя);
	Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Элемент.ПравоеЗначение = Значение;
	Элемент.Использование = Истина;
КонецПроцедуры

#КонецОбласти
