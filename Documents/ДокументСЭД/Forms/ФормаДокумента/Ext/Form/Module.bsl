#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Шапка = ДинамическиеФормы.ДобавитьГруппу(ЭтотОбъект, "Шапка", "Документ");
	ДинамическиеФормы.ДобавитьПоле(ЭтотОбъект, "Номер", "Объект.Номер", "Номер", Шапка).ТолькоПросмотр = Истина;
	ДинамическиеФормы.ДобавитьПоле(ЭтотОбъект, "Дата", "Объект.Дата", "Дата", Шапка);
	ДинамическиеФормы.ДобавитьПоле(ЭтотОбъект, "Статус", "Объект.Статус", "Статус", Шапка).ТолькоПросмотр = Истина;
	ДинамическиеФормы.ДобавитьПоле(ЭтотОбъект, "Категория", "Категория", "Категория", Шапка).УстановитьДействие("ПриИзменении", "КатегорияПриИзменении");
	ПолеВида = ДинамическиеФормы.ДобавитьПоле(ЭтотОбъект, "ВидДокумента", "Объект.ВидДокумента", "Вид документа", Шапка);
	ПолеВида.РежимВыбораИзСписка = Истина;
	ПолеВида.КнопкаОткрытия = Ложь;
	ПолеВида.УстановитьДействие("ПриИзменении", "ВидДокументаПриИзменении");
	РабочаяОбласть = ДинамическиеФормы.ДобавитьГруппу(ЭтотОбъект, "РабочаяОбласть", "");
	РабочаяОбласть.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно;
	ДинамическиеФормы.ДобавитьГруппу(ЭтотОбъект, "ПоляВида", "Поля документа", РабочаяОбласть);
	Подвал = ДинамическиеФормы.ДобавитьГруппу(ЭтотОбъект, "Участники", "Участники и комментарий");
	Ответственный = ДинамическиеФормы.ДобавитьПоле(ЭтотОбъект, "Ответственный", "Объект.Ответственный", "Ответственный", Подвал);
	Ответственный.АвтоОтметкаНезаполненного = Истина;
	Ответственный.УстановитьДействие("ПриИзменении", "ОтветственныйПриИзменении");
	ДинамическиеФормы.ДобавитьПоле(ЭтотОбъект, "Руководитель", "Объект.Руководитель", "Руководитель", Подвал);
	ДинамическиеФормы.ДобавитьПоле(ЭтотОбъект, "Комментарий", "Объект.Комментарий", "Комментарий", Подвал).МногострочныйРежим = Истина;
	Согласование = ДинамическиеФормы.ДобавитьГруппу(ЭтотОбъект, "Согласование", "Согласование", РабочаяОбласть);
	ДинамическиеФормы.ДобавитьПоле(ЭтотОбъект, "ТекущийСогласующий", "Объект.ТекущийСогласующий", "Текущий согласующий", Согласование).ТолькоПросмотр = Истина;
	Таймлайн = ДинамическиеФормы.ДобавитьПоле(ЭтотОбъект, "Таймлайн", "ТаймлайнHTML", "Маршрут", Согласование);
	Таймлайн.Вид = ВидПоляФормы.ПолеHTMLДокумента;
	Таймлайн.Высота = 10;
	Таблица = Элементы.Добавить("История", Тип("ТаблицаФормы"), Согласование);
	Таблица.ПутьКДанным = "История";
	Таблица.ТолькоПросмотр = Истина;
	Для Каждого Имя Из СтрРазделить("Цикл,НомерЭтапа,Сотрудник,Решение,ДатаРешения,Комментарий", ",") Цикл
		ДинамическиеФормы.ДобавитьПоле(ЭтотОбъект, "История" + Имя, "История." + Имя, Имя, Таблица);
	КонецЦикла;
	Элементы.ИсторияНомерЭтапа.Заголовок = "Этап";
	Элементы.ИсторияДатаРешения.Заголовок = "Дата решения";
	Элементы.Статус.Вид = ВидПоляФормы.ПолеНадписи;
	Элементы.Статус.Шрифт = Новый Шрифт(, , Истина);
	Элементы.ТекущийСогласующий.Шрифт = Новый Шрифт(, 14, Истина);
	Элементы.Переместить(Элементы.Участники);
	Действия = ДинамическиеФормы.ДобавитьГруппу(ЭтотОбъект, "Действия", "");
	ДинамическиеФормы.ДобавитьКнопку(ЭтотОбъект, "Проверить", "Проверить заполнение", "Проверить", Действия);
	ДинамическиеФормы.ДобавитьКнопку(ЭтотОбъект, "Отправить", "На согласование", "ОжидаемИнтеграцию", Действия);
	ДинамическиеФормы.ДобавитьКнопку(ЭтотОбъект, "Согласовать", "Согласовать", "ОжидаемИнтеграцию", Действия);
	Элементы.Согласовать.КнопкаПоУмолчанию = Истина;
	Элементы.Отправить.ЦветФона = ЦветаСтиля.АкцентПродукта;
	ДинамическиеФормы.ДобавитьКнопку(ЭтотОбъект, "Отклонить", "Отклонить", "ОжидаемИнтеграцию", Действия);
	ДинамическиеФормы.ДобавитьКнопку(ЭтотОбъект, "Печать", "Печать", "ОжидаемИнтеграцию", Действия);
	ДинамическиеФормы.ДобавитьПоле(ЭтотОбъект, "Интеграция", "Интеграция", "", Действия).ТолькоПросмотр = Истина;
	ДинамическиеФормы.НастроитьЦветаСтатуса(УсловноеОформление, "Объект.Статус");
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
			Объект.Дата = ТекущаяДатаСеанса();
		КонецЕсли;
		Объект.Статус = Перечисления.СтатусыДокументов.Черновик;
	КонецЕсли;
	ПодготовитьДанныеФормы();
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	Если Элементы.Найти("ПоляВида") <> Неопределено Тогда
		ПодготовитьДанныеФормы();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	ПодготовитьДанныеФормы();
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Ошибки = ДинамическиеФормы.ОшибкиДокумента(ЭтотОбъект);
	Если Ошибки.Количество() > 0 Тогда
		Отказ = Истина;
		ДинамическиеФормы.ВывестиОшибки(ЭтотОбъект, Ошибки);
		Возврат;
	КонецЕсли;
	ДинамическиеФормы.ПеренестиЗначенияВОбъект(ЭтотОбъект);
	// ТекущийОбъект уже получен платформой до события: переносим также в него.
	ТекущийОбъект.ЗначенияПолей.Очистить();
	Для Каждого СтрокаЗначения Из Объект.ЗначенияПолей Цикл
		СтрокаОбъекта = ТекущийОбъект.ЗначенияПолей.Добавить();
		СтрокаОбъекта.Поле = СтрокаЗначения.Поле;
		СтрокаОбъекта.Значение = СтрокаЗначения.Значение;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Отказ = Не ПроверитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Проверить(Команда)
	Если ПроверитьНаСервере() Тогда
		ПоказатьОповещениеПользователя("Все обязательные поля заполнены");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КатегорияПриИзменении(Элемент)
	Если ЗначениеЗаполнено(ПредыдущийВид) Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеПодтвержденияКатегории", ЭтотОбъект),
			"Смена категории очистит вид и введённые поля. Продолжить?", РежимДиалогаВопрос.ДаНет);
	Иначе
		КатегорияИзмененаНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВидДокументаПриИзменении(Элемент)
	Если ЗначениеЗаполнено(ПредыдущийВид) И Объект.ВидДокумента <> ПредыдущийВид Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеПодтвержденияВида", ЭтотОбъект),
			"Смена вида очистит введённые поля. Продолжить?", РежимДиалогаВопрос.ДаНет);
	Иначе
		ВидИзмененНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияКатегории(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		КатегорияИзмененаНаСервере();
	Иначе
		Категория = ПредыдущаяКатегория;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияВида(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ВидИзмененНаСервере();
	Иначе
		Объект.ВидДокумента = ПредыдущийВид;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтветственныйПриИзменении(Элемент)
	ПодставитьРуководителя();
КонецПроцедуры

&НаКлиенте
Процедура ПолеВидаПриИзменении(Элемент)
	Элемент.ОтметкаНезаполненного = Ложь;
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ОжидаемИнтеграцию(Команда)
	ПоказатьОповещениеПользователя(Интеграция);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПодготовитьДанныеФормы()
	Если ЗначениеЗаполнено(Объект.ВидДокумента) Тогда
		Категория = Объект.ВидДокумента.Категория;
	КонецЕсли;
	ПредыдущаяКатегория = Категория;
	ПредыдущийВид = Объект.ВидДокумента;
	ДинамическиеФормы.ПостроитьПоляВида(ЭтотОбъект);
	ОбновитьВыборВида();
	Редактирование = Объект.Статус = Перечисления.СтатусыДокументов.Черновик
		Или Объект.Статус = Перечисления.СтатусыДокументов.НаДоработке;
	Элементы.ПоляВида.Доступность = Редактирование;
	Элементы.Участники.Доступность = Редактирование;
	Элементы.Дата.ТолькоПросмотр = Не Редактирование;
	// В записанном документе вид фиксирован: смена требует миграции значений.
	Элементы.Категория.Доступность = Не ЗначениеЗаполнено(Объект.Ссылка);
	Элементы.ВидДокумента.Доступность = Не ЗначениеЗаполнено(Объект.Ссылка)
		И ЗначениеЗаполнено(Категория);
	ТаймлайнHTML = ДинамическиеФормы.ТаймлайнHTML(РеквизитФормыВЗначение("Объект"));
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Цикл, НомерЭтапа, Сотрудник, Решение, ДатаРешения, Комментарий
		|ИЗ РегистрСведений.ИсторияСогласования
		|ГДЕ Документ = &Документ
		|УПОРЯДОЧИТЬ ПО Цикл, ДатаРешения, НомерЭтапа";
	Запрос.УстановитьПараметр("Документ", Объект.Ссылка);
	ЗначениеВРеквизитФормы(Запрос.Выполнить().Выгрузить(), "История");
	Доступность = ДинамическиеФормы.ДоступныеДействия();
	Интеграция = Доступность.Причина;
	Элементы.Отправить.Доступность = Доступность.Отправка;
	Элементы.Согласовать.Доступность = Доступность.Решение;
	Элементы.Отклонить.Доступность = Доступность.Решение;
	Элементы.Печать.Доступность = Доступность.Печать;
КонецПроцедуры

&НаСервере
Процедура ОбновитьВыборВида()
	Элементы.ВидДокумента.СписокВыбора.Очистить();
	Если Не ЗначениеЗаполнено(Категория) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Вид Из КонструкторВидов.ВидыДляСоздания(Категория) Цикл
		Элементы.ВидДокумента.СписокВыбора.Добавить(Вид.Вид, Вид.Наименование);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура КатегорияИзмененаНаСервере()
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Категория = ПредыдущаяКатегория;
		Возврат;
	КонецЕсли;
	Объект.ВидДокумента = Справочники.ВидыДокументов.ПустаяСсылка();
	Объект.ЗначенияПолей.Очистить();
	ПодготовитьДанныеФормы();
	Элементы.ВидДокумента.Доступность = ЗначениеЗаполнено(Категория);
КонецПроцедуры

&НаСервере
Процедура ВидИзмененНаСервере()
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.ВидДокумента = ПредыдущийВид;
		Возврат;
	КонецЕсли;
	Вид = Объект.ВидДокумента;
	Если ЗначениеЗаполнено(Вид) Тогда
		Если Вид.Категория <> Категория
			Или Вид.СтатусНастройки <> Перечисления.СтатусыНастройкиВида.Готов
			Или Вид.ПометкаУдаления Тогда
			Объект.ВидДокумента = ПредыдущийВид;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Если Объект.ВидДокумента <> ПредыдущийВид Тогда
		Объект.ЗначенияПолей.Очистить();
	КонецЕсли;
	ПодготовитьДанныеФормы();
КонецПроцедуры

&НаСервере
Процедура ПодставитьРуководителя()
	Объект.Руководитель = Документы.ДокументСЭД.РуководительОтветственного(Объект.Ответственный);
КонецПроцедуры

&НаСервере
Функция ПроверитьНаСервере()
	Ошибки = ДинамическиеФормы.ОшибкиДокумента(ЭтотОбъект);
	ДинамическиеФормы.ВывестиОшибки(ЭтотОбъект, Ошибки);
	Если Ошибки.Количество() = 0 Тогда
		ДинамическиеФормы.ПеренестиЗначенияВОбъект(ЭтотОбъект);
	КонецЕсли;
	Возврат Ошибки.Количество() = 0;
КонецФункции

#КонецОбласти
