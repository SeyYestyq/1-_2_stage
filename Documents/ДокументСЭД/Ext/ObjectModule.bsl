#Область ОбработчикиСобытий

// Заполняет служебные реквизиты при создании и присваивает номер «префикс вида + счётчик».
// Номера разных видов не пересекаются: счётчик считается в пределах вида.
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если Новый() Тогда

		Если ПустаяСтрока(Автор) Тогда
			Автор = ИмяПользователя();
		КонецЕсли;

		Если Статус = Неопределено Или Статус.Пустая() Тогда
			Статус = Перечисления.СтатусыДокументов.Черновик;
		КонецЕсли;

		Если ПустаяСтрока(Номер) И Не ВидДокумента.Пустая() Тогда
			Номер = СледующийНомер(ВидДокумента);
		КонецЕсли;

		Если ЦиклСогласования = 0 Тогда
			ЦиклСогласования = 1;
		КонецЕсли;

	КонецЕсли;

	// Документ правится только в статусах «Черновик» и «На доработке».
	// Изменять согласованный документ может только код движка согласования:
	// он выставляет дополнительное свойство РазрешитьЗаписьДвижка (см. контракт с Максимом).
	Если Не Новый() И Не Отказ Тогда
		ПроверитьЗапретПравки(Отказ);
	КонецЕсли;

КонецПроцедуры

// Проверяет заполнение обязательных реквизитов и значений полей вида.
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если ВидДокумента = Неопределено Или ВидДокумента.Пустая() Тогда
		Отказ = Истина;
		СообщитьПроверку("ВидДокумента", "Не выбран вид документа.");
		Возврат;
	КонецЕсли;

	Если Ответственный = Неопределено Или Ответственный.Пустая() Тогда
		Отказ = Истина;
		СообщитьПроверку("Ответственный",
			"Не указан ответственный. Без ответственного документ нельзя отправить на согласование.");
		Возврат;
	КонецЕсли;

	// Руководитель подставляется из карточки ответственного, но остаётся редактируемым:
	// письмо о смене статуса получают и ответственный, и его руководитель.
	Если Руководитель = Неопределено Или Руководитель.Пустая() Тогда
		Руководитель = Документы.ДокументСЭД.РуководительОтветственного(Ответственный);
	КонецЕсли;

	ПроверитьЗначенияПолей(Отказ);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Номер документа: префикс вида и порядковый номер в пределах этого вида.
// Пример: «Д-0001», «ВХ-0001» — номера разных видов не пересекаются.
Функция СледующийНомер(Вид)

	Префикс = "";
	ОбъектВида = Вид.ПолучитьОбъект();
	Если ОбъектВида <> Неопределено Тогда
		Префикс = ОбъектВида.Префикс;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ДокументСЭД.Номер КАК Номер
		|ИЗ
		|	Документ.ДокументСЭД КАК ДокументСЭД
		|ГДЕ
		|	ДокументСЭД.ВидДокумента = &Вид
		|	И ДокументСЭД.Номер ПОДОБНО &Шаблон";
	Запрос.УстановитьПараметр("Вид", Вид);
	Запрос.УстановитьПараметр("Шаблон", Префикс + "%");

	Выборка = Запрос.Выполнить().Выбрать();
	Максимальный = 0;
	ДлинаПрефикса = СтрДлина(Префикс);

	Пока Выборка.Следующий() Цикл

		НомерДокумента = Выборка.Номер;
		Если СтрДлина(НомерДокумента) <= ДлинаПрефикса Тогда
			Продолжить;
		КонецЕсли;

		ЧисловаяЧасть = Прав(НомерДокумента, СтрДлина(НомерДокумента) - ДлинаПрефикса);
		Если Число(ЧисловаяЧасть) > Максимальный Тогда
			Максимальный = Число(ЧисловаяЧасть);
		КонецЕсли;

	КонецЦикла;

	Возврат Префикс + Формат(Максимальный + 1, "ЧЦ=4; ЧВН=; ЧГ=0");

КонецФункции

// Запрет правки документа в статусах, когда он уже ушёл по маршруту.
Процедура ПроверитьЗапретПравки(Отказ)

	РазрешенаЗапись = Ложь;
	Если ДополнительныеСвойства.Свойство("РазрешитьЗаписьДвижка") Тогда
		РазрешенаЗапись = ДополнительныеСвойства.РазрешитьЗаписьДвижка;
	КонецЕсли;

	Если РазрешенаЗапись = Истина Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ДокументСЭД.Статус КАК Статус
		|ИЗ
		|	Документ.ДокументСЭД КАК ДокументСЭД
		|ГДЕ
		|	ДокументСЭД.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;

	СтатусВБазе = Выборка.Статус;

	Если СтатусВБазе = Перечисления.СтатусыДокументов.Черновик
		Или СтатусВБазе = Перечисления.СтатусыДокументов.НаДоработке Тогда
		Возврат;
	КонецЕсли;

	Отказ = Истина;
	СообщитьПроверку("Статус",
		СтрШаблон("Документ в статусе «%1» редактировать нельзя. Изменение возможно только"
			+ " через движок согласования и только в статусах «Черновик» или «На доработке».",
			СтатусВБазе));

КонецПроцедуры

// Проверяет значения полей документа по описанию полей вида: обязательность и формат.
Процедура ПроверитьЗначенияПолей(Отказ)

	ПоляВида = КонструкторВидов.ПоляВида(ВидДокумента);
	Если ПоляВида.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ЗначенияПоПолю = Новый Соответствие;
	Для Каждого СтрокаЗначения Из ЗначенияПолей Цикл
		ЗначенияПоПолю.Вставить(СтрокаЗначения.Поле, СтрокаЗначения.Значение);
	КонецЦикла;

	Для Каждого ОписаниеПоля Из ПоляВида Цикл

		Значение = ЗначенияПоПолю.Получить(ОписаниеПоля.Поле);

		Если Значение = Неопределено Тогда

			Если ОписаниеПоля.Обязательное = Истина Тогда
				Отказ = Истина;
				СообщитьПроверку("ЗначенияПолей",
					СтрШаблон("Не заполнено обязательное поле «%1».", ОписаниеПоля.Заголовок));
			КонецЕсли;
			Продолжить;

		КонецЕсли;

		ТолькоПоложительное = Ложь;
		ОбъектПоля = ОписаниеПоля.Поле.ПолучитьОбъект();
		Если ОбъектПоля <> Неопределено Тогда
			ТолькоПоложительное = ОбъектПоля.ТолькоПоложительное;
		КонецЕсли;

		ТекстОшибки = КонструкторВидов.ОшибкиФормата(Значение, ОписаниеПоля.ТипПоля, ТолькоПоложительное);
		Если Не ПустаяСтрока(ТекстОшибки) Тогда
			Отказ = Истина;
			СообщитьПроверку("ЗначенияПолей",
				СтрШаблон("Поле «%1»: %2", ОписаниеПоля.Заголовок, ТекстОшибки));
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура СообщитьПроверку(Поле, Текст)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.ПутьКДанным = Поле;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти
