&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Объект.СтатусНастройки.Пустая() Тогда
		Объект.СтатусНастройки = Перечисления.СтатусыНастройкиВида.Черновик;
	КонецЕсли;
	ОбновитьОформлениеСтатуса();

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	ОбновитьОформлениеСтатуса();

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	ОбновитьОформлениеСтатуса();

КонецПроцедуры

&НаСервере
Процедура ОбновитьОформлениеСтатуса()

	Если Объект.СтатусНастройки = Перечисления.СтатусыНастройкиВида.Готов Тогда
		БейджСтатуса = "✓ Готов";
		Элементы.БейджСтатуса.ЦветТекста = ЦветаСтиля.СтатусСогласованЦвет;
		Элементы.БейджСтатуса.ЦветФона = ЦветаСтиля.СтатусСогласованФон;
	Иначе
		БейджСтатуса = "○ Черновик";
		Элементы.БейджСтатуса.ЦветТекста = ЦветаСтиля.СтатусЧерновикЦвет;
		Элементы.БейджСтатуса.ЦветФона = ЦветаСтиля.СтатусЧерновикФон;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИнструкцию(Команда)

	Текст =
	"Настроить вид документа
	|
	|1. Заполните поля «Наименование», «Категория» и «Префикс».
	|
	|2. В таблице «1. Поля документа» добавьте не меньше одного поля.
	|В колонке «Тип поля» выберите: Строка, Число, Дата или Выбор из списка.
	|
	|3. Если тип поля «Выбор из списка»: выделите строку поля, нажмите «Значения списка»
	|и добавьте не меньше двух значений (кнопка «Создать» в открывшемся списке).
	|
	|4. В таблице «2. Маршрут согласования» добавьте не меньше двух этапов.
	|
	|5. Нажмите «Записать».
	|
	|6. Нажмите «Проверить и сохранить шаблон».
	|
	|7. Нажмите «Опубликовать вид».
	|Пока вид в статусе «Черновик», его нельзя выбрать в документе.";
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияСправки", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ОК, , , "Справка");

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияСправки(РезультатВопроса, ДополнительныеПараметры) Экспорт
КонецПроцедуры

&НаКлиенте
Процедура ЗначенияСписка(Команда)

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Или Модифицированность Тогда
		ПоказатьПредупреждение(, "Сначала нажмите «Записать».");
		Возврат;
	КонецЕсли;

	ТекДанные = Элементы.Поля.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "В таблице «1. Поля документа» выделите строку поля.");
		Возврат;
	КонецЕсли;

	Если ТекДанные.ТипПоля <> ПредопределенноеЗначение("Перечисление.ТипыПолей.ВыборИзСписка") Тогда
		ПоказатьПредупреждение(,
			"Значения списка нужны только для типа «Выбор из списка». В колонке «Тип поля» выберите это значение.");
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(ТекДанные.Идентификатор) Тогда
		ПоказатьПредупреждение(, "У выбранного поля заполните «Идентификатор», затем нажмите «Записать».");
		Возврат;
	КонецЕсли;

	Отбор = Новый Структура;
	Отбор.Вставить("Владелец", Объект.Ссылка);
	Отбор.Вставить("ИдентификаторПоля", ТекДанные.Идентификатор);

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", Отбор);
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", Отбор);

	ОткрытьФорму("Справочник.ЗначенияПолей.ФормаСписка", ПараметрыФормы);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьШаблон(Команда)

	Если Модифицированность Тогда
		ПоказатьПредупреждение(, "Сначала нажмите «Записать».");
		Возврат;
	КонецЕсли;

	Результат = ПроверитьШаблонНаСервере(Объект.Ссылка);
	Текст = СтрСоединить(Результат.Сообщения, Символы.ПС);
	Если Результат.Успех Тогда
		ПоказатьОповещениеПользователя("ДокМаршрут", , Текст);
	Иначе
		ПоказатьПредупреждение(, Текст);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОпубликоватьВид(Команда)

	Если Модифицированность Тогда
		ПоказатьПредупреждение(, "Сначала нажмите «Записать».");
		Возврат;
	КонецЕсли;

	Результат = ОпубликоватьВидНаСервере(Объект.Ссылка);
	Текст = СтрСоединить(Результат.Сообщения, Символы.ПС);
	Если Результат.Успех Тогда
		ПоказатьОповещениеПользователя("ДокМаршрут", , Текст);
		Прочитать();
	Иначе
		ПоказатьПредупреждение(, Текст);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьШаблонНаСервере(СсылкаВид)

	Возврат КонструкторВидов.ПроверитьШаблон(СсылкаВид);

КонецФункции

&НаСервереБезКонтекста
Функция ОпубликоватьВидНаСервере(СсылкаВид)

	Возврат КонструкторВидов.ОпубликоватьВид(СсылкаВид);

КонецФункции
