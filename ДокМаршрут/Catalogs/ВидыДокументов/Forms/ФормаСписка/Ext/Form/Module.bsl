&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Заголовок = "Виды документов";
	ПрименитьОтборы();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИнструкцию(Команда)

	Текст =
	"Виды документов
	|
	|1. Нажмите «Создать».
	|2. Заполните поля и маршрут, затем нажмите «Записать».
	|3. Для поля «Выбор из списка» нажмите «Значения списка» и добавьте значения.
	|4. Нажмите «Проверить и сохранить шаблон».
	|5. Нажмите «Опубликовать вид».
	|
	|В шапке списка: «Категория» и «Статус настройки» — быстрые отборы.
	|В документе можно выбрать только вид со статусом «Готов».
	|Подробные шаги: «Справка» (i) в карточке вида.";
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияСправки", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ОК, , , "Справка");

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияСправки(РезультатВопроса, ДополнительныеПараметры) Экспорт
КонецПроцедуры

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)

	ПрименитьОтборы();

КонецПроцедуры

&НаСервере
Процедура ПрименитьОтборы()

	Отбор = Список.Отбор;
	УдалитьОтборПоПолю(Отбор, "Категория");
	УдалитьОтборПоПолю(Отбор, "СтатусНастройки");

	Если ЗначениеЗаполнено(ОтборКатегория) Тогда
		ДобавитьОтборРавно(Отбор, "Категория", ОтборКатегория);
	КонецЕсли;
	Если ЗначениеЗаполнено(ОтборСтатусНастройки) Тогда
		ДобавитьОтборРавно(Отбор, "СтатусНастройки", ОтборСтатусНастройки);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ДобавитьОтборРавно(Отбор, ИмяПоля, Значение)

	ЭлементОтбора = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Значение;
	ЭлементОтбора.Использование = Истина;

КонецПроцедуры

&НаСервере
Процедура УдалитьОтборПоПолю(Отбор, ИмяПоля)

	КУдалению = Новый Массив;
	Для Каждого ЭлементОтбора Из Отбор.Элементы Цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных")
			И Строка(ЭлементОтбора.ЛевоеЗначение) = ИмяПоля Тогда
			КУдалению.Добавить(ЭлементОтбора);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ЭлементОтбора Из КУдалению Цикл
		Отбор.Элементы.Удалить(ЭлементОтбора);
	КонецЦикла;

КонецПроцедуры
