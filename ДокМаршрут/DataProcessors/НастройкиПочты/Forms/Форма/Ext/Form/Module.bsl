&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Настройки = Уведомления.ПрочитатьНастройкиSMTP();
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Настройки);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИнструкцию(Команда)

	Текст =
	"Настройка почты
	|
	|1. В блоке «Сервер» укажите адрес SMTP, порт и при необходимости включите флажок «Использовать SSL».
	|2. В блоке «Учётная запись» введите логин и пароль SMTP.
	|3. В блоке «Отправитель» укажите адрес отправителя.
	|4. Нажмите «Записать настройки».
	|5. Нажмите «Проверить отправку».
	|Тестовое письмо уйдёт на адрес отправителя.
	|
	|Письма по документам идут ответственному и руководителю (Email в карточке сотрудника).";
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияСправки", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ОК, , , "Справка");

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияСправки(РезультатВопроса, ДополнительныеПараметры) Экспорт
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьНастройки(Команда)

	ЗаписатьНастройкиНаСервере();
	ПоказатьОповещениеПользователя("ДокМаршрут", , "Настройки почты записаны.");

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОтправку(Команда)

	ЗаписатьНастройкиНаСервере();
	Результат = ПроверитьОтправкуНаСервере();
	Если Результат.Успех Тогда
		ПоказатьОповещениеПользователя("ДокМаршрут", , Результат.Текст);
	Иначе
		ПоказатьПредупреждение(, Результат.Текст);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаписатьНастройкиНаСервере()

	Настройки = Новый Структура;
	Настройки.Вставить("АдресSMTP", АдресSMTP);
	Настройки.Вставить("ПортSMTP", ПортSMTP);
	Настройки.Вставить("ИспользоватьSSL", ИспользоватьSSL);
	Настройки.Вставить("ЛогинSMTP", ЛогинSMTP);
	Настройки.Вставить("ПарольSMTP", ПарольSMTP);
	Настройки.Вставить("АдресОтправителя", АдресОтправителя);
	Настройки.Вставить("ТаймаутSMTP", ?(ТаймаутSMTP = 0, 30, ТаймаутSMTP));
	Уведомления.ЗаписатьНастройкиSMTP(Настройки);

КонецПроцедуры

&НаСервере
Функция ПроверитьОтправкуНаСервере()

	Возврат Уведомления.ПроверитьОтправку(АдресОтправителя);

КонецФункции
