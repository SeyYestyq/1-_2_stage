&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Объект.Статус.Пустая() Тогда
		Объект.Статус = Перечисления.СтатусыДокументов.Черновик;
	КонецЕсли;

	// В списке выбора — только опубликованные виды (не черновики P0).
	ПараметрыВыбораВида = Новый Массив;
	ПараметрыВыбораВида.Добавить(Новый ПараметрВыбора(
		"Отбор.СтатусНастройки",
		Перечисления.СтатусыНастройкиВида.Готов));
	Элементы.ВидДокумента.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораВида);

	НастроитьОформлениеТаймлайна();
	ОбновитьИсториюНаСервере();
	ОбновитьТаймлайнНаСервере();
	ОбновитьОформлениеСтатуса();
	ОбновитьПодписьПолучателейПисем();
	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	НастроитьСписокВыбораЗначенияПоля();

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	ОбновитьИсториюНаСервере();
	ОбновитьТаймлайнНаСервере();
	ОбновитьОформлениеСтатуса();
	ОбновитьПодписьПолучателейПисем();
	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	ОбновитьИсториюНаСервере();
	ОбновитьТаймлайнНаСервере();
	ОбновитьОформлениеСтатуса();
	ОбновитьПодписьПолучателейПисем();
	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура УчастникПриИзменении(Элемент)

	Если Элемент.Имя = "Ответственный" Тогда
		ПодставитьРуководителяПоОтветственному();
	КонецЕсли;
	ОбновитьПодписьПолучателейПисем();

КонецПроцедуры

&НаСервере
Процедура ПодставитьРуководителяПоОтветственному()

	Если Не ЗначениеЗаполнено(Объект.Ответственный) Тогда
		Возврат;
	КонецЕсли;
	Объект.Руководитель = Объект.Ответственный.Руководитель;

КонецПроцедуры

&НаСервере
Процедура ОбновитьПодписьПолучателейПисем()

	ПодписьПолучателейПисем = Уведомления.ТекстКомуУходятПисьма(Объект);

КонецПроцедуры

&НаСервере
Процедура ОбновитьОформлениеСтатуса()

	// Цвета только из элементов стиля (брендбук / палитра 8.5), без RGB в коде.
	Если Объект.Статус = Перечисления.СтатусыДокументов.НаСогласовании Тогда
		БейджСтатуса = "● На согласовании";
		Элементы.БейджСтатуса.ЦветТекста = ЦветаСтиля.СтатусНаСогласованииЦвет;
		Элементы.БейджСтатуса.ЦветФона = ЦветаСтиля.СтатусНаСогласованииФон;
	ИначеЕсли Объект.Статус = Перечисления.СтатусыДокументов.Согласован Тогда
		БейджСтатуса = "✓ Согласован";
		Элементы.БейджСтатуса.ЦветТекста = ЦветаСтиля.СтатусСогласованЦвет;
		Элементы.БейджСтатуса.ЦветФона = ЦветаСтиля.СтатусСогласованФон;
	ИначеЕсли Объект.Статус = Перечисления.СтатусыДокументов.Отклонен Тогда
		БейджСтатуса = "✕ Отклонён";
		Элементы.БейджСтатуса.ЦветТекста = ЦветаСтиля.СтатусОтклоненЦвет;
		Элементы.БейджСтатуса.ЦветФона = ЦветаСтиля.СтатусОтклоненФон;
	ИначеЕсли Объект.Статус = Перечисления.СтатусыДокументов.НаДоработке Тогда
		БейджСтатуса = "↺ На доработке";
		Элементы.БейджСтатуса.ЦветТекста = ЦветаСтиля.СтатусНаДоработкеЦвет;
		Элементы.БейджСтатуса.ЦветФона = ЦветаСтиля.СтатусНаДоработкеФон;
	Иначе
		БейджСтатуса = "○ Черновик";
		Элементы.БейджСтатуса.ЦветТекста = ЦветаСтиля.СтатусЧерновикЦвет;
		Элементы.БейджСтатуса.ЦветФона = ЦветаСтиля.СтатусЧерновикФон;
	КонецЕсли;

	НаСогласовании = Объект.Статус = Перечисления.СтатусыДокументов.НаСогласовании;
	Отклонён = Объект.Статус = Перечисления.СтатусыДокументов.Отклонен;
	ЕстьМаршрут = Таймлайн.Количество() > 0 Или Объект.МаршрутСнимок.Количество() > 0;

	Если ЗначениеЗаполнено(Объект.ТекущийСогласующий) Тогда
		ПодписьСогласующего = Строка(Объект.ТекущийСогласующий);
	Иначе
		ПодписьСогласующего = "—";
	КонецЕсли;
	Элементы.ПодписьСогласующего.Видимость = НаСогласовании;

	ЗаголовокВида = ?(ЗначениеЗаполнено(Объект.ВидДокумента), Строка(Объект.ВидДокумента), "Документ");
	НомерТекст = ?(ЗначениеЗаполнено(Объект.Номер), Объект.Номер, "новый");
	Заголовок = ЗаголовокВида + " № " + НомерТекст;

	Если Объект.ВсегоЭтапов > 0 И Объект.ТекущийЭтап > 0 Тогда
		Элементы.ГруппаМаршрут.Заголовок = СтрШаблон(
			"Маршрут · этап %1 из %2",
			Объект.ТекущийЭтап,
			Объект.ВсегоЭтапов);
	ИначеЕсли Объект.Статус = Перечисления.СтатусыДокументов.Согласован Тогда
		Элементы.ГруппаМаршрут.Заголовок = "Маршрут · согласован";
	ИначеЕсли Отклонён Тогда
		Элементы.ГруппаМаршрут.Заголовок = "Маршрут · отклонён";
	Иначе
		Элементы.ГруппаМаршрут.Заголовок = "Маршрут согласования";
	КонецЕсли;

	// Свёртка задаётся в Form.xml (Collapsed); в 8.5.1 у группы нет свойства «Свернута» в рантайме.
	Элементы.ГруппаМаршрут.Видимость = ЕстьМаршрут
		Или Объект.Статус = Перечисления.СтатусыДокументов.НаСогласовании
		Или Объект.Статус = Перечисления.СтатусыДокументов.Согласован
		Или Отклонён;
	Элементы.ГруппаИстория.Видимость = Отклонён Или История.Количество() > 0;

	Если Не ЗначениеЗаполнено(Объект.ВидДокумента) Тогда
		ПодсказкаШага = "В поле «Вид документа» выберите значение. Категория подставится автоматически.";
	ИначеЕсли Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПодсказкаШага = "Заполните «Поля документа» и «Суть», затем нажмите «Записать».";
	ИначеЕсли Объект.Статус = Перечисления.СтатусыДокументов.Черновик
		Или Объект.Статус = Перечисления.СтатусыДокументов.НаДоработке Тогда
		ПодсказкаШага = "Номер присвоен. Нажмите «Отправить на согласование».";
	ИначеЕсли НаСогласовании Тогда
		ПодсказкаШага = "Документ на согласовании. Решение принимает текущий согласующий.";
	ИначеЕсли Объект.Статус = Перечисления.СтатусыДокументов.Согласован Тогда
		ПодсказкаШага = "Документ согласован. «Предпросмотр»: открыть форму. «Отправить на почту»: письмо с вложением.";
	ИначеЕсли Отклонён Тогда
		ПодсказкаШага = "Документ отклонён. Комментарий смотрите в блоке «История согласования».";
	Иначе
		ПодсказкаШага = "";
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьДоступностьКоманд()

	ЧерновикИлиДоработка = Объект.Статус = Перечисления.СтатусыДокументов.Черновик
		Или Объект.Статус = Перечисления.СтатусыДокументов.НаДоработке;
	НаСогласовании = Объект.Статус = Перечисления.СтатусыДокументов.НаСогласовании;
	Отклонён = Объект.Статус = Перечисления.СтатусыДокументов.Отклонен;
	ДокументЗаписан = ЗначениеЗаполнено(Объект.Ссылка);

	ЯСогласующий = Ложь;
	Если НаСогласовании Тогда
		ЯСогласующий = Согласование.ЭтоАктивныйСогласующий(Объект);
	КонецЕсли;

	Элементы.КнопкаОтправить.Видимость = ЧерновикИлиДоработка;
	Элементы.КнопкаСогласовать.Видимость = НаСогласовании И ЯСогласующий;
	Элементы.КнопкаОтклонить.Видимость = НаСогласовании И ЯСогласующий;
	// HIG/M3: не больше 1–2 prominent; «Вернуть» только после отклонения.
	Элементы.КнопкаДоработка.Видимость = Отклонён;
	Элементы.КнопкаПечать.Видимость = ДокументЗаписан;
	Элементы.КнопкаОтправитьФорму.Видимость = ДокументЗаписан;

	Элементы.КнопкаОтправить.КнопкаПоУмолчанию = Ложь;
	Элементы.КнопкаСогласовать.КнопкаПоУмолчанию = Ложь;
	Элементы.КнопкаДоработка.КнопкаПоУмолчанию = Ложь;
	Элементы.КнопкаПечать.КнопкаПоУмолчанию = Ложь;
	Элементы.КнопкаОтправитьФорму.КнопкаПоУмолчанию = Ложь;

	// Пока документ не записан — главный шаг платформы «Записать», не «На согласование».
	Если ЧерновикИлиДоработка И ДокументЗаписан Тогда
		Элементы.КнопкаОтправить.КнопкаПоУмолчанию = Истина;
	ИначеЕсли НаСогласовании И ЯСогласующий Тогда
		Элементы.КнопкаСогласовать.КнопкаПоУмолчанию = Истина;
	ИначеЕсли Отклонён Тогда
		Элементы.КнопкаДоработка.КнопкаПоУмолчанию = Истина;
	ИначеЕсли Элементы.КнопкаПечать.Видимость Тогда
		Элементы.КнопкаПечать.КнопкаПоУмолчанию = Истина;
	КонецЕсли;

	// Содержимое только в черновике / на доработке; согласование идёт кнопками.
	ТолькоПросмотрСодержания = Не ЧерновикИлиДоработка;
	Элементы.ВидДокумента.ТолькоПросмотр = ТолькоПросмотрСодержания;
	Элементы.Автор.ТолькоПросмотр = ТолькоПросмотрСодержания;
	Элементы.Ответственный.ТолькоПросмотр = ТолькоПросмотрСодержания;
	Элементы.Руководитель.ТолькоПросмотр = ТолькоПросмотрСодержания;
	Элементы.Содержание.ТолькоПросмотр = ТолькоПросмотрСодержания;
	Элементы.ЗначенияПолей.ТолькоПросмотр = ТолькоПросмотрСодержания;

КонецПроцедуры

&НаКлиенте
Процедура СообщитьРезультат(Текст, ЭтоОшибка = Ложь)

	Если ЭтоОшибка Тогда
		ПоказатьПредупреждение(, Текст);
	Иначе
		ПоказатьОповещениеПользователя("ДокМаршрут", , Текст);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИнструкцию(Команда)

	// Текст по Google/Microsoft procedures: Где → действие; результат отдельной строкой.
	// «ёлочки» для имён UI. Без ПоказатьПредупреждение — у неё иконка ошибки.
	Текст =
	"Создать документ и отправить на согласование
	|
	|1. В поле «Вид документа» выберите значение:
	|Служебная записка
	|Договор поставки
	|Исходящее письмо
	|Категория подставится автоматически.
	|
	|2. В таблице «Поля документа» заполните значения строк.
	|Для полей «Выбор из списка» откройте выпадающий список в колонке «Значение»
	|и выберите одно из значений, заданных в виде документа.
	|
	|3. В поле «Суть» кратко опишите документ.
	|
	|4. В блоке «Кто участвует» в поле «Ответственный» выберите сотрудника.
	|Письма при смене статуса идут ответственному и руководителю (Email из карточки сотрудника).
	|
	|5. Нажмите «Записать».
	|В заголовке формы появится номер, например СЗ-00000001.
	|
	|6. Нажмите «Отправить на согласование».
	|Откроется блок «Маршрут согласования».
	|
	|После согласования:
	|«Предпросмотр»: открыть печатную форму.
	|«Отправить на почту»: письмо с вложением ответственному и руководителю.
	|
	|В блоке «Маршрут согласования» цвета строк показывают прогресс:
	|пройденные, текущий, ожидающие и отклонённый этапы.
	|
	|Согласовать или отклонить может только текущий согласующий.
	|В списке документов кнопка «Мои задачи» показывает документы, которые ждут вашего решения.";
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияСправки", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ОК, , , "Справка");

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияСправки(РезультатВопроса, ДополнительныеПараметры) Экспорт
КонецПроцедуры

&НаКлиенте
Процедура ВидДокументаПриИзменении(Элемент)

	ПрименитьВидНаСервере();
	ОбновитьОформлениеСтатуса();
	НастроитьСписокВыбораЗначенияПоля();

КонецПроцедуры

&НаКлиенте
Процедура ЗначенияПолейПриАктивизацииСтроки(Элемент)

	НастроитьСписокВыбораЗначенияПоля();

КонецПроцедуры

&НаКлиенте
Процедура ЗначенияПолейПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	НастроитьСписокВыбораЗначенияПоля();

КонецПроцедуры

&НаКлиенте
Процедура НастроитьСписокВыбораЗначенияПоля()

	ПолеЗначения = Элементы.ЗначенияПолейЗначениеСтрока;
	ПолеЗначения.СписокВыбора.Очистить();
	ПолеЗначения.КнопкаВыпадающегоСписка = Ложь;
	ПолеЗначения.РежимВыбораИзСписка = Ложь;
	ПолеЗначения.ПодсказкаВвода = "";

	ТекДанные = Элементы.ЗначенияПолей.ТекущиеДанные;
	Если ТекДанные = Неопределено Или Не ЗначениеЗаполнено(Объект.ВидДокумента) Тогда
		Возврат;
	КонецЕсли;

	Настройки = НастройкиВыбораЗначенияНаСервере(Объект.ВидДокумента, ТекДанные.Идентификатор);
	Если Настройки.ТипПоля = "ВыборИзСписка" Тогда
		Для Каждого Наименование Из Настройки.Значения Цикл
			ПолеЗначения.СписокВыбора.Добавить(Наименование);
		КонецЦикла;
		ПолеЗначения.КнопкаВыпадающегоСписка = Истина;
		ПолеЗначения.РежимВыбораИзСписка = Истина;
	ИначеЕсли Настройки.ТипПоля = "Число" Тогда
		ПолеЗначения.ПодсказкаВвода = "Число, например 150000";
	ИначеЕсли Настройки.ТипПоля = "Дата" Тогда
		ПолеЗначения.ПодсказкаВвода = "Дата, например 31.12.2026";
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция НастройкиВыбораЗначенияНаСервере(ВидСсылка, ИдентификаторПоля)

	Результат = Новый Структура("ТипПоля, Значения", "", Новый Массив);
	ТипПоля = ДинамическиеФормы.ТипПоляПоИдентификатору(ВидСсылка, ИдентификаторПоля);
	Если ТипПоля = Перечисления.ТипыПолей.ВыборИзСписка Тогда
		Результат.ТипПоля = "ВыборИзСписка";
		Результат.Значения = ДинамическиеФормы.НаименованияЗначенийСписка(ВидСсылка, ИдентификаторПоля);
	ИначеЕсли ТипПоля = Перечисления.ТипыПолей.Число Тогда
		Результат.ТипПоля = "Число";
	ИначеЕсли ТипПоля = Перечисления.ТипыПолей.Дата Тогда
		Результат.ТипПоля = "Дата";
	Иначе
		Результат.ТипПоля = "Строка";
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ПрименитьВидНаСервере()

	Если Не ЗначениеЗаполнено(Объект.ВидДокумента) Тогда
		Объект.ЗначенияПолей.Очистить();
		Возврат;
	КонецЕсли;

	ВидОбъект = Объект.ВидДокумента.ПолучитьОбъект();
	Объект.Категория = ВидОбъект.Категория;
	Объект.ЗначенияПолей.Очистить();
	ДинамическиеФормы.ЗаполнитьЗначенияПолейИзВида(Объект, ВидОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьНаСогласование(Команда)

	ТекстПроверки = ПроверитьПередОтправкойНаСервере();
	Если Не ПустаяСтрока(ТекстПроверки) Тогда
		СообщитьРезультат(ТекстПроверки, Истина);
		Возврат;
	КонецЕсли;

	Если Модифицированность Или Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Записать();
	КонецЕсли;

	Результат = ОтправитьНаСогласованиеНаСервере(Объект.Ссылка);
	СообщитьРезультат(Результат.Текст, Не Результат.Успех);
	Если Результат.Успех Тогда
		Прочитать();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Согласовать(Команда)
	ПринятьРешениеКлиент(ПредопределенноеЗначение("Перечисление.РешенияСогласования.Согласовано"), "");
КонецПроцедуры

&НаКлиенте
Процедура Отклонить(Команда)
	Комментарий = "";
	Если Не ВвестиСтроку(Комментарий, "Отклонение документа", 250) Тогда
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(Комментарий) Тогда
		СообщитьРезультат("Укажите в комментарии, что нужно исправить.", Истина);
		Возврат;
	КонецЕсли;
	ПринятьРешениеКлиент(ПредопределенноеЗначение("Перечисление.РешенияСогласования.Отклонено"), Комментарий);
КонецПроцедуры

&НаКлиенте
Процедура ВернутьНаДоработку(Команда)
	Комментарий = "";
	Если Не ВвестиСтроку(Комментарий, "Возврат на доработку", 250) Тогда
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(Комментарий) Тогда
		Комментарий = "Возврат на доработку";
	КонецЕсли;
	ПринятьРешениеКлиент(
		ПредопределенноеЗначение("Перечисление.РешенияСогласования.ВозвращенНаДоработку"),
		Комментарий);
КонецПроцедуры

&НаКлиенте
Процедура ПечатьPDF(Команда)

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		СообщитьРезультат("Сначала нажмите «Записать».", Истина);
		Возврат;
	КонецЕсли;

	Результат = ПечатьНаСервере(Объект.Ссылка);
	Если Не Результат.Успех Тогда
		СообщитьРезультат(Результат.Текст, Истина);
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(Результат.АдресХранилища) Тогда
		СообщитьРезультат(Результат.Текст, Ложь);
		Возврат;
	КонецЕсли;

	// Предпросмотр: PDF (коммерческая) или HTML (учебная лицензия).
	ИмяЛокального = КаталогВременныхФайлов() + Результат.ИмяФайлаКлиент;
	Попытка
		ПолучитьФайл(Результат.АдресХранилища, ИмяЛокального, Ложь);
		ЗапуститьПриложение(ИмяЛокального);
		СообщитьРезультат("Печатная форма открыта.", Ложь);
	Исключение
		СообщитьРезультат(
			"Файл готов, но не открылся. Сохраните его вручную из папки временных файлов.",
			Истина);
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьПечатнуюФорму(Команда)

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		СообщитьРезультат("Сначала нажмите «Записать».", Истина);
		Возврат;
	КонецЕсли;

	ОбновитьПодписьПолучателейПисем();
	Если Не ПустаяСтрока(ПодписьПолучателейПисем) Тогда
		Ответ = Вопрос(
			ПодписьПолучателейПисем + Символы.ПС + Символы.ПС + "Отправить на почту этим получателям?",
			РежимДиалогаВопрос.ДаНет);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Результат = ОтправитьПечатнуюФормуНаСервере(Объект.Ссылка);
	СообщитьРезультат(Результат.Текст, Не Результат.Успех);

КонецПроцедуры

&НаКлиенте
Процедура ПринятьРешениеКлиент(Решение, Комментарий)

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		СообщитьРезультат("Сначала нажмите «Записать».", Истина);
		Возврат;
	КонецЕсли;

	Результат = ПринятьРешениеНаСервере(Объект.Ссылка, Решение, Комментарий);
	СообщитьРезультат(Результат.Текст, Не Результат.Успех);
	Если Результат.Успех Тогда
		Прочитать();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьИсториюНаСервере()

	История.Очистить();
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	Таблица = Согласование.ИсторияДляКарточки(Объект.Ссылка);
	Для Каждого СтрокаИстории Из Таблица Цикл
		НоваяСтрока = История.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИстории);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ОбновитьТаймлайнНаСервере()

	Таймлайн.Очистить();
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если Объект.МаршрутСнимок.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		Для Каждого СтрокаМаршрута Из Объект.МаршрутСнимок Цикл
			НоваяСтрока = Таймлайн.Добавить();
			НоваяСтрока.Номер = СтрокаМаршрута.НомерЭтапа;
			НоваяСтрока.Название = СтрокаМаршрута.НазваниеЭтапа;
			НоваяСтрока.Согласующий = Строка(СтрокаМаршрута.Согласующий);
			НоваяСтрока.Состояние = "Ожидает";
		КонецЦикла;
		Возврат;
	КонецЕсли;

	Таблица = Согласование.ЭтапыДляТаймлайна(Объект.Ссылка);
	Для Каждого СтрокаЭтапа Из Таблица Цикл
		НоваяСтрока = Таймлайн.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЭтапа);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура НастроитьОформлениеТаймлайна()

	ДобавитьОформлениеСостоянияТаймлайна(
		"Пройден",
		ЦветаСтиля.СтатусСогласованЦвет,
		ЦветаСтиля.СтатусСогласованФон);
	ДобавитьОформлениеСостоянияТаймлайна(
		"Текущий",
		ЦветаСтиля.СтатусНаСогласованииЦвет,
		ЦветаСтиля.СтатусНаСогласованииФон);
	ДобавитьОформлениеСостоянияТаймлайна(
		"Ожидает",
		ЦветаСтиля.СтатусЧерновикЦвет,
		ЦветаСтиля.СтатусЧерновикФон);
	ДобавитьОформлениеСостоянияТаймлайна(
		"Отклонён",
		ЦветаСтиля.СтатусОтклоненЦвет,
		ЦветаСтиля.СтатусОтклоненФон);

КонецПроцедуры

&НаСервере
Процедура ДобавитьОформлениеСостоянияТаймлайна(Состояние, ЦветТекста, ЦветФона)

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();

	Для Каждого ИмяКолонки Из СтрРазделить("Номер,Название,Согласующий,Состояние", ",", Ложь) Цикл
		Поле = ЭлементОформления.Поля.Элементы.Добавить();
		Поле.Поле = Новый ПолеКомпоновкиДанных("Таймлайн." + ИмяКолонки);
		Поле.Использование = Истина;
	КонецЦикла;

	Отбор = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Таймлайн.Состояние");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Состояние;
	Отбор.Использование = Истина;

	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветТекста);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФона);
	ЭлементОформления.Использование = Истина;

КонецПроцедуры

