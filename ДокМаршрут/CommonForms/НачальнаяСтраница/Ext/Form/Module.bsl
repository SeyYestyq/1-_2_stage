#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОбновитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	ОбновитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокумент(Команда)
	ОткрытьФорму("Документ.ДокументСЭД.ФормаДокумента", , ЭтаФорма, , , ,
		Новый ОписаниеОповещения("ПослеЗакрытияРабочейФормы", ЭтотОбъект));
КонецПроцедуры

&НаКлиенте
Процедура СоздатьВид(Команда)
	ОткрытьФорму("Справочник.ВидыДокументов.ФормаМастер", , ЭтаФорма, , , ,
		Новый ОписаниеОповещения("ПослеЗакрытияРабочейФормы", ЭтотОбъект));
КонецПроцедуры

&НаКлиенте
Процедура ВсеДокументы(Команда)
	ОткрытьФорму("Документ.ДокументСЭД.ФормаСписка");
КонецПроцедуры

&НаКлиенте
Процедура ВсеМоиДокументы(Команда)
	ОткрытьФорму("Документ.ДокументСЭД.ФормаСписка",
		Новый Структура("ПоказатьМоиДокументы", Истина), , Истина);
КонецПроцедуры

&НаКлиенте
Процедура ВсеМоиСогласования(Команда)
	ОткрытьФорму("Документ.ДокументСЭД.ФормаСписка",
		Новый Структура("ПоказатьМоиСогласования", Истина), , Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДокумент(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	СтрокаДокумента = Элемент.ТекущиеДанные;
	Если СтрокаДокумента <> Неопределено Тогда
		ОткрытьФорму("Документ.ДокументСЭД.ФормаДокумента",
			Новый Структура("Ключ", СтрокаДокумента.Ссылка), ЭтаФорма, , , ,
			Новый ОписаниеОповещения("ПослеЗакрытияРабочейФормы", ЭтотОбъект));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияРабочейФормы(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	ОбновитьНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеСтраницы

&НаСервере
Процедура ОбновитьНаСервере()
	Данные = ДинамическиеФормы.ДанныеНачальнойСтраницы();
	ЗначениеВРеквизитФормы(Данные.Документы, "МоиДокументы");
	ЗначениеВРеквизитФормы(Данные.Согласования, "МоиСогласования");
	Пояснение = Данные.Пояснение;
	Приветствие = ?(ЗначениеЗаполнено(Данные.Сотрудник), "ДокМаршрут — " + Строка(Данные.Сотрудник), "ДокМаршрут");
	ВсегоДокументов = 0;
	ВсегоСогласований = Данные.ВсегоСогласований;
	Черновики = 0;
	НаСогласовании = 0;
	Согласованы = 0;
	Отклонены = 0;
	НаДоработке = 0;
	Для Каждого Счетчик Из Данные.Счетчики Цикл
		ВсегоДокументов = ВсегоДокументов + Счетчик.Количество;
		Если Счетчик.Статус = Перечисления.СтатусыДокументов.Черновик Тогда
			Черновики = Счетчик.Количество;
		ИначеЕсли Счетчик.Статус = Перечисления.СтатусыДокументов.НаСогласовании Тогда
			НаСогласовании = Счетчик.Количество;
		ИначеЕсли Счетчик.Статус = Перечисления.СтатусыДокументов.Согласован Тогда
			Согласованы = Счетчик.Количество;
		ИначеЕсли Счетчик.Статус = Перечисления.СтатусыДокументов.Отклонен Тогда
			Отклонены = Счетчик.Количество;
		ИначеЕсли Счетчик.Статус = Перечисления.СтатусыДокументов.НаДоработке Тогда
			НаДоработке = Счетчик.Количество;
		КонецЕсли;
	КонецЦикла;
	Элементы.БлокСогласования.Заголовок = СтрШаблон("Ожидают вашего решения: %1", ВсегоСогласований);
	Элементы.БлокДокументы.Заголовок = СтрШаблон("Мои документы: %1", ВсегоДокументов);
	Элементы.КнопкаВсеМоиДокументы.Доступность = ЗначениеЗаполнено(Данные.Сотрудник);
	Элементы.КнопкаВсеМоиСогласования.Доступность = ЗначениеЗаполнено(Данные.Сотрудник);
	Элементы.Счетчики.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно;
	Для Каждого Имя Из СтрРазделить("Черновики,НаСогласовании,Согласованы,Отклонены,НаДоработке", ",") Цикл
		Элементы[Имя].Формат = "ЧГ=0;ЧДЦ=0;ЧН=0";
	КонецЦикла;
	Элементы.Приветствие.Шрифт = Новый Шрифт(, 18, Истина);
	Элементы.Черновики.ЦветТекста = ЦветаСтиля.СтатусЧерновикЦвет;
	Элементы.НаСогласовании.ЦветТекста = ЦветаСтиля.СтатусНаСогласованииЦвет;
	Элементы.Согласованы.ЦветТекста = ЦветаСтиля.СтатусСогласованЦвет;
	Элементы.Отклонены.ЦветТекста = ЦветаСтиля.СтатусОтклоненЦвет;
	Элементы.НаДоработке.ЦветТекста = ЦветаСтиля.СтатусНаДоработкеЦвет;
КонецПроцедуры

#КонецОбласти
