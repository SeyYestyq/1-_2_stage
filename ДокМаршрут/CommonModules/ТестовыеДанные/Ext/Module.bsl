Функция СоздатьДемоБазу() Экспорт

	СозданоСотрудников = СоздатьСотрудников();
	СозданоВидов = СоздатьВиды();
	СозданоДокументов = СоздатьДокументы();

	Возврат СтрШаблон(
		"Загружено: сотрудников %1, видов %2, документов СЭД %3.",
		СозданоСотрудников,
		СозданоВидов,
		СозданоДокументов);

КонецФункции

Функция СоздатьСотрудников()

	Данные = Новый Массив;
	Данные.Добавить(Новый Структура("Имя, Должность, Email", "Иванов Сергей", "Юрист", "ivanov@example.com"));
	Данные.Добавить(Новый Структура("Имя, Должность, Email", "Петрова Анна", "Бухгалтер", "petrova@example.com"));
	Данные.Добавить(Новый Структура("Имя, Должность, Email", "Сидоров Олег", "Менеджер", "sidorov@example.com"));
	Данные.Добавить(Новый Структура("Имя, Должность, Email", "Козлова Мария", "Директор", "kozlova@example.com"));
	Данные.Добавить(Новый Структура("Имя, Должность, Email", "Никитин Денис", "Секретарь", "nikitin@example.com"));

	Создано = 0;
	Для Каждого Строка Из Данные Цикл
		Ссылка = НайтиСотрудника(Строка.Имя);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		Объект = Справочники.Сотрудники.СоздатьЭлемент();
		Объект.Наименование = Строка.Имя;
		Объект.Должность = Строка.Должность;
		Объект.Email = Строка.Email;
		Объект.Записать();
		Создано = Создано + 1;
	КонецЦикла;

	ПривязатьТекущегоПользователяИБ();
	Возврат Создано;

КонецФункции

Процедура ПривязатьТекущегоПользователяИБ()

	Имя = ИмяПользователя();
	Если ПустаяСтрока(Имя) Тогда
		Возврат;
	КонецЕсли;

	// Если уже есть привязка к этому логину — ничего не меняем.
	Сотрудник = Согласование.ТекущийСотрудник();
	Если ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат;
	КонецЕсли;

	// Для демо: текущий пользователь ИБ = первый согласующий (юрист).
	Ссылка = НайтиСотрудника("Иванов Сергей");
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Ссылка = НайтиСотрудникаПоДолжности("Юрист");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;

	Объект = Ссылка.ПолучитьОбъект();
	Объект.ИмяПользователяИБ = Имя;
	Объект.Записать();

КонецПроцедуры

Функция СоздатьВиды()

	Создано = 0;
	Создано = Создано + СоздатьВид(
		"Служебная записка",
		Перечисления.КатегорииДокументов.Входящий,
		"СЗ",
		Новый Структура(
			"Поля, Этапы",
			"Тема,Суть,Срочность:ВыборИзСписка",
			"Юрист|Согласование,Директор|Утверждение"));
	Создано = Создано + СоздатьВид(
		"Договор поставки",
		Перечисления.КатегорииДокументов.Договорной,
		"Д",
		Новый Структура(
			"Поля, Этапы",
			"Контрагент,Сумма:Число,СрокДействия:Дата,ФормаОплаты:ВыборИзСписка",
			"Юрист|Правовой,Бухгалтер|Финансы,Директор|Подпись"));
	Создано = Создано + СоздатьВид(
		"Исходящее письмо",
		Перечисления.КатегорииДокументов.Исходящий,
		"ИСХ",
		Новый Структура(
			"Поля, Этапы",
			"Адресат,Текст,ДатаОтправки:Дата",
			"Секретарь|Подготовка,Менеджер|Отправка"));

	// Идемпотентно для уже созданных видов: типы и значения списков.
	ОбеспечитьПолеСрочность(НайтиВид("Служебная записка"));
	ОбеспечитьПоляДоговора(НайтиВид("Договор поставки"));
	ОбеспечитьПоляИсходящего(НайтиВид("Исходящее письмо"));
	Возврат Создано;

КонецФункции

Функция СоздатьВид(Наименование, Категория, Префикс, ОписаниеСтруктуры)

	Ссылка = НайтиВид(Наименование);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат 0;
	КонецЕсли;

	Вид = Справочники.ВидыДокументов.СоздатьЭлемент();
	Вид.Наименование = Наименование;
	Вид.Категория = Категория;
	Вид.Префикс = Префикс;
	Вид.СтатусНастройки = Перечисления.СтатусыНастройкиВида.Черновик;

	Порядок = 1;
	ИменаПолей = СтрРазделить(ОписаниеСтруктуры.Поля, ",", Ложь);
	Для Каждого ОписаниеПоля Из ИменаПолей Цикл
		ЧастиПоля = СтрРазделить(СокрЛП(ОписаниеПоля), ":", Ложь);
		ЗаголовокПоля = СокрЛП(ЧастиПоля[0]);
		ТипИмя = ?(ЧастиПоля.Количество() > 1, СокрЛП(ЧастиПоля[1]), "Строка");

		Строка = Вид.Поля.Добавить();
		Строка.Порядок = Порядок;
		Строка.Заголовок = ЗаголовокПоля;
		Строка.Идентификатор = СтрЗаменить(ЗаголовокПоля, " ", "");
		Строка.ТипПоля = ТипПоляПоИмени(ТипИмя);
		Строка.Обязательное = Истина;
		Строка.Длина = 200;
		Порядок = Порядок + 1;
	КонецЦикла;

	Этапы = СтрРазделить(ОписаниеСтруктуры.Этапы, ",", Ложь);
	Номер = 1;
	Для Каждого Этап Из Этапы Цикл
		Части = СтрРазделить(Этап, "|", Ложь);
		Должность = СокрЛП(Части[0]);
		Название = ?(Части.Количество() > 1, СокрЛП(Части[1]), Должность);
		Сотрудник = НайтиСотрудникаПоДолжности(Должность);
		СтрокаМ = Вид.Маршрут.Добавить();
		СтрокаМ.НомерЭтапа = Номер;
		СтрокаМ.НазваниеЭтапа = Название;
		СтрокаМ.Согласующий = Сотрудник;
		Номер = Номер + 1;
	КонецЦикла;

	Вид.Записать();
	// Для «Выбор из списка» значения нужны до публикации (проверка ≥ 2).
	Если Наименование = "Служебная записка" Тогда
		ОбеспечитьЗначенияСрочности(Вид.Ссылка);
	ИначеЕсли Наименование = "Договор поставки" Тогда
		ОбеспечитьЗначенияФормыОплаты(Вид.Ссылка);
	КонецЕсли;
	КонструкторВидов.ОпубликоватьВид(Вид.Ссылка);
	Возврат 1;

КонецФункции

Функция ТипПоляПоИмени(ТипИмя)

	Если ТипИмя = "Число" Тогда
		Возврат Перечисления.ТипыПолей.Число;
	ИначеЕсли ТипИмя = "Дата" Тогда
		Возврат Перечисления.ТипыПолей.Дата;
	ИначеЕсли ТипИмя = "ВыборИзСписка" Тогда
		Возврат Перечисления.ТипыПолей.ВыборИзСписка;
	КонецЕсли;
	Возврат Перечисления.ТипыПолей.Строка;

КонецФункции

Процедура ОбеспечитьПолеСрочность(ВидСсылка)

	Если Не ЗначениеЗаполнено(ВидСсылка) Тогда
		Возврат;
	КонецЕсли;

	Идентификатор = "Срочность";
	ВидОбъект = ВидСсылка.ПолучитьОбъект();
	ЕстьПоле = Ложь;
	НужнаЗапись = Ложь;
	Для Каждого СтрокаПоля Из ВидОбъект.Поля Цикл
		Если СтрокаПоля.Идентификатор = Идентификатор Тогда
			ЕстьПоле = Истина;
			Если СтрокаПоля.ТипПоля <> Перечисления.ТипыПолей.ВыборИзСписка Тогда
				СтрокаПоля.ТипПоля = Перечисления.ТипыПолей.ВыборИзСписка;
				НужнаЗапись = Истина;
			КонецЕсли;
			Если СтрокаПоля.Заголовок <> "Срочность" Тогда
				СтрокаПоля.Заголовок = "Срочность";
				НужнаЗапись = Истина;
			КонецЕсли;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не ЕстьПоле Тогда
		СтрокаПоля = ВидОбъект.Поля.Добавить();
		СтрокаПоля.Порядок = ВидОбъект.Поля.Количество();
		СтрокаПоля.Заголовок = "Срочность";
		СтрокаПоля.Идентификатор = Идентификатор;
		СтрокаПоля.ТипПоля = Перечисления.ТипыПолей.ВыборИзСписка;
		СтрокаПоля.Обязательное = Истина;
		СтрокаПоля.Длина = 200;
		НужнаЗапись = Истина;
	КонецЕсли;

	Если НужнаЗапись Тогда
		ВидОбъект.Записать();
	КонецЕсли;

	ОбеспечитьЗначенияСрочности(ВидСсылка);

КонецПроцедуры

Процедура ОбеспечитьЗначенияСрочности(ВидСсылка)

	ОбеспечитьЗначениеСписка(ВидСсылка, "Срочность", "Обычная");
	ОбеспечитьЗначениеСписка(ВидСсылка, "Срочность", "Срочная");
	ОбеспечитьЗначениеСписка(ВидСсылка, "Срочность", "Критическая");

КонецПроцедуры

Процедура ОбеспечитьЗначенияФормыОплаты(ВидСсылка)

	ОбеспечитьЗначениеСписка(ВидСсылка, "ФормаОплаты", "Аванс");
	ОбеспечитьЗначениеСписка(ВидСсылка, "ФормаОплаты", "Постоплата");

КонецПроцедуры

Процедура ОбеспечитьПоляДоговора(ВидСсылка)

	Если Не ЗначениеЗаполнено(ВидСсылка) Тогда
		Возврат;
	КонецЕсли;

	ОбеспечитьПолеВида(ВидСсылка, "Сумма", "Сумма", Перечисления.ТипыПолей.Число);
	ОбеспечитьПолеВида(ВидСсылка, "СрокДействия", "Срок действия", Перечисления.ТипыПолей.Дата);
	ОбеспечитьПолеВида(ВидСсылка, "ФормаОплаты", "Форма оплаты", Перечисления.ТипыПолей.ВыборИзСписка);
	ОбеспечитьЗначенияФормыОплаты(ВидСсылка);

КонецПроцедуры

Процедура ОбеспечитьПоляИсходящего(ВидСсылка)

	Если Не ЗначениеЗаполнено(ВидСсылка) Тогда
		Возврат;
	КонецЕсли;

	ОбеспечитьПолеВида(ВидСсылка, "ДатаОтправки", "Дата отправки", Перечисления.ТипыПолей.Дата);

КонецПроцедуры

Процедура ОбеспечитьПолеВида(ВидСсылка, Идентификатор, ЗаголовокПоля, ТипПоля)

	ВидОбъект = ВидСсылка.ПолучитьОбъект();
	ЕстьПоле = Ложь;
	НужнаЗапись = Ложь;
	Для Каждого СтрокаПоля Из ВидОбъект.Поля Цикл
		Если СтрокаПоля.Идентификатор = Идентификатор Тогда
			ЕстьПоле = Истина;
			Если СтрокаПоля.ТипПоля <> ТипПоля Тогда
				СтрокаПоля.ТипПоля = ТипПоля;
				НужнаЗапись = Истина;
			КонецЕсли;
			Если СтрокаПоля.Заголовок <> ЗаголовокПоля Тогда
				СтрокаПоля.Заголовок = ЗаголовокПоля;
				НужнаЗапись = Истина;
			КонецЕсли;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не ЕстьПоле Тогда
		СтрокаПоля = ВидОбъект.Поля.Добавить();
		СтрокаПоля.Порядок = ВидОбъект.Поля.Количество();
		СтрокаПоля.Заголовок = ЗаголовокПоля;
		СтрокаПоля.Идентификатор = Идентификатор;
		СтрокаПоля.ТипПоля = ТипПоля;
		СтрокаПоля.Обязательное = Истина;
		СтрокаПоля.Длина = 200;
		НужнаЗапись = Истина;
	КонецЕсли;

	Если НужнаЗапись Тогда
		ВидОбъект.Записать();
	КонецЕсли;

КонецПроцедуры

Процедура ОбеспечитьЗначениеСписка(ВидСсылка, ИдентификаторПоля, Наименование)

	Если ЗначениеЗаполнено(НайтиЗначениеПоля(ВидСсылка, ИдентификаторПоля, Наименование)) Тогда
		Возврат;
	КонецЕсли;

	Элемент = Справочники.ЗначенияПолей.СоздатьЭлемент();
	Элемент.Владелец = ВидСсылка;
	Элемент.ИдентификаторПоля = ИдентификаторПоля;
	Элемент.Наименование = Наименование;
	Элемент.Записать();

КонецПроцедуры

Функция НайтиЗначениеПоля(ВидСсылка, ИдентификаторПоля, Наименование)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗначенияПолей.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ЗначенияПолей КАК ЗначенияПолей
	|ГДЕ
	|	ЗначенияПолей.Владелец = &Вид
	|	И ЗначенияПолей.ИдентификаторПоля = &ИдентификаторПоля
	|	И ЗначенияПолей.Наименование = &Наименование";
	Запрос.УстановитьПараметр("Вид", ВидСсылка);
	Запрос.УстановитьПараметр("ИдентификаторПоля", ИдентификаторПоля);
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.ЗначенияПолей.ПустаяСсылка();

КонецФункции

Функция СоздатьДокументы()

	Виды = Новый Массив;
	Виды.Добавить(НайтиВид("Служебная записка"));
	Виды.Добавить(НайтиВид("Договор поставки"));
	Виды.Добавить(НайтиВид("Исходящее письмо"));

	Создано = 0;
	Для Индекс = 1 По 6 Цикл
		Вид = Виды[(Индекс - 1) % Виды.Количество()];
		Если Не ЗначениеЗаполнено(Вид) Тогда
			Продолжить;
		КонецЕсли;
		КлючДемо = "Демо-документ " + Формат(Индекс, "ЧГ=0");
		Если ЗначениеЗаполнено(НайтиДокументПоКлючуДемо(КлючДемо)) Тогда
			Продолжить;
		КонецЕсли;

		Автор = НайтиСотрудника("Никитин Денис");
		Ответственный = НайтиСотрудника("Сидоров Олег");
		Руководитель = НайтиСотрудника("Козлова Мария");

		Док = Документы.ДокументСЭД.СоздатьДокумент();
		Док.Дата = ТекущаяДатаСеанса();
		Док.ВидДокумента = Вид;
		Док.Категория = Вид.Категория;
		Док.Автор = Автор;
		Док.Ответственный = Ответственный;
		Док.Руководитель = Руководитель;
		Док.Статус = Перечисления.СтатусыДокументов.Черновик;
		Док.Содержание = КлючДемо;
		ДинамическиеФормы.ЗаполнитьЗначенияПолейИзВида(Док, Вид.ПолучитьОбъект());
		Док.Записать();
		Создано = Создано + 1;
	КонецЦикла;

	Возврат Создано;

КонецФункции

Функция НайтиСотрудника(Наименование)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Сотрудники.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.Наименование = &Наименование";
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.Сотрудники.ПустаяСсылка();

КонецФункции

Функция НайтиСотрудникаПоДолжности(Должность)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Сотрудники.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.Должность = &Должность";
	Запрос.УстановитьПараметр("Должность", Должность);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.Сотрудники.ПустаяСсылка();

КонецФункции

Функция НайтиВид(Наименование)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Виды.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыДокументов КАК Виды
	|ГДЕ
	|	Виды.Наименование = &Наименование";
