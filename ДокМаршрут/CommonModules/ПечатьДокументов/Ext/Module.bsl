Функция СформироватьPDF(ДокументСсылка) Экспорт

	// Совместимость: сначала PDF; на учебной лицензии Записать(PDF) запрещён.
	Возврат СформироватьВложениеПечатнойФормы(ДокументСсылка);

КонецФункции

// Возвращает файл для кнопки «Печать» и для вложения в письмо.
// На коммерческой платформе — PDF; на учебной 8.5 — HTML (запись табличного документа запрещена).
Функция СформироватьВложениеПечатнойФормы(ДокументСсылка) Экспорт

	Результат = Новый Структура(
		"Успех, ИмяФайла, Текст, ФорматВложения, ИмяФайлаКлиент",
		Ложь, "", "", "", "");

	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	ИмяБазы = СтрШаблон(
		"%1_%2",
		СокрЛП(ДокументОбъект.Номер),
		СтрЗаменить(Строка(ДокументОбъект.ВидДокумента), " ", "_"));

	ТабличныйДокумент = ПечатнаяФорма(ДокументОбъект);
	ИмяФайлаPDF = ПолучитьИмяВременногоФайла("pdf");

	Попытка
		ТабличныйДокумент.Записать(ИмяФайлаPDF, ТипФайлаТабличногоДокумента.PDF);
		Результат.Успех = Истина;
		Результат.ИмяФайла = ИмяФайлаPDF;
		Результат.ФорматВложения = "PDF";
		Результат.ИмяФайлаКлиент = ИмяБазы + ".pdf";
		Результат.Текст = "Печатная форма готова (PDF)";
		Возврат Результат;
	Исключение
		ТекстОшибкиPDF = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Попытка
			УдалитьФайлы(ИмяФайлаPDF);
		Исключение
		КонецПопытки;
		// Учебная лицензия: «Функции печати и сохранения табличного документа … недоступны».
		Если СтрНайти(ВРег(ТекстОшибкиPDF), "ЛИЦЕНЗ") = 0
			И СтрНайти(ВРег(ТекстОшибкиPDF), "УЧЕБН") = 0
			И СтрНайти(ВРег(ТекстОшибкиPDF), "ТАБЛИЧН") = 0 Тогда
			Результат.Текст = ТекстОшибкиPDF;
			Возврат Результат;
		КонецЕсли;
	КонецПопытки;

	Попытка
		ИмяФайлаHTML = ПолучитьИмяВременногоФайла("html");
		Запись = Новый ЗаписьТекста(ИмяФайлаHTML, КодировкаТекста.UTF8);
		Запись.Записать(ТекстHTMLПечатнойФормы(ДокументОбъект));
		Запись.Закрыть();
		Результат.Успех = Истина;
		Результат.ИмяФайла = ИмяФайлаHTML;
		Результат.ФорматВложения = "HTML";
		Результат.ИмяФайлаКлиент = ИмяБазы + ".html";
		Результат.Текст =
			"На учебной версии PDF недоступен. Открыта HTML-копия печатной формы.";
	Исключение
		Результат.Текст = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция ПечатнаяФорма(ДокументОбъект) Экспорт

	Макет = Документы.ДокументСЭД.ПолучитьМакет("ПечатнаяФормаДокумента");
	ТабличныйДокумент = Новый ТабличныйДокумент;

	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Номер = ДокументОбъект.Номер;
	ОбластьШапка.Параметры.Дата = Формат(ДокументОбъект.Дата, "ДЛФ=D");
	ОбластьШапка.Параметры.ВидДокумента = Строка(ДокументОбъект.ВидДокумента);
	ОбластьШапка.Параметры.Статус = Строка(ДокументОбъект.Статус);
	ОбластьШапка.Параметры.Ответственный = Строка(ДокументОбъект.Ответственный);
	ОбластьШапка.Параметры.ТекущийЭтап = ДокументОбъект.ТекущийЭтап;
	ОбластьШапка.Параметры.ВсегоЭтапов = ДокументОбъект.ВсегоЭтапов;
	ТабличныйДокумент.Вывести(ОбластьШапка);

	ОбластьСтрокаПоля = Макет.ПолучитьОбласть("СтрокаПоля");
	Для Каждого СтрокаЗначения Из ДокументОбъект.ЗначенияПолей Цикл
		ОбластьСтрокаПоля.Параметры.Заголовок = СтрокаЗначения.Заголовок;
		ОбластьСтрокаПоля.Параметры.ЗначениеСтрока = СтрокаЗначения.ЗначениеСтрока;
		ТабличныйДокумент.Вывести(ОбластьСтрокаПоля);
	КонецЦикла;

	ОбластьСтрокаМаршрута = Макет.ПолучитьОбласть("СтрокаМаршрута");
	Для Каждого СтрокаМаршрута Из ДокументОбъект.МаршрутСнимок Цикл
		ОбластьСтрокаМаршрута.Параметры.НомерЭтапа = СтрокаМаршрута.НомерЭтапа;
		ОбластьСтрокаМаршрута.Параметры.НазваниеЭтапа = СтрокаМаршрута.НазваниеЭтапа;
		ОбластьСтрокаМаршрута.Параметры.Согласующий = Строка(СтрокаМаршрута.Согласующий);
		ТабличныйДокумент.Вывести(ОбластьСтрокаМаршрута);
	КонецЦикла;

	Возврат ТабличныйДокумент;

КонецФункции

Функция ТекстHTMLПечатнойФормы(ДокументОбъект)

	Строки = Новый Массив;
	Строки.Добавить("<!DOCTYPE html><html><head><meta charset=""utf-8"">");
	Строки.Добавить("<title>ДокМаршрут</title>");
	Строки.Добавить("<style>body{font-family:sans-serif;margin:24px}h1{font-size:18px}");
	Строки.Добавить("table{border-collapse:collapse;width:100%;margin:12px 0}");
	Строки.Добавить("td,th{border:1px solid #ccc;padding:6px 8px;text-align:left}</style></head><body>");
	Строки.Добавить(СтрШаблон("<h1>%1 № %2 от %3</h1>",
		ЭкранироватьHTML(Строка(ДокументОбъект.ВидДокумента)),
		ЭкранироватьHTML(СокрЛП(ДокументОбъект.Номер)),
		ЭкранироватьHTML(Формат(ДокументОбъект.Дата, "ДЛФ=D"))));
	Строки.Добавить(СтрШаблон("<p>Статус: <b>%1</b>. Ответственный: %2. Этап: %3 из %4.</p>",
		ЭкранироватьHTML(Строка(ДокументОбъект.Статус)),
		ЭкранироватьHTML(Строка(ДокументОбъект.Ответственный)),
		ДокументОбъект.ТекущийЭтап,
		ДокументОбъект.ВсегоЭтапов));

	Строки.Добавить("<h2>Поля</h2><table><tr><th>Поле</th><th>Значение</th></tr>");
	Для Каждого СтрокаЗначения Из ДокументОбъект.ЗначенияПолей Цикл
		Строки.Добавить(СтрШаблон("<tr><td>%1</td><td>%2</td></tr>",
			ЭкранироватьHTML(СтрокаЗначения.Заголовок),
			ЭкранироватьHTML(СтрокаЗначения.ЗначениеСтрока)));
	КонецЦикла;
	Строки.Добавить("</table>");

	Строки.Добавить("<h2>Маршрут</h2><table><tr><th>№</th><th>Этап</th><th>Согласующий</th></tr>");
	Для Каждого СтрокаМаршрута Из ДокументОбъект.МаршрутСнимок Цикл
		Строки.Добавить(СтрШаблон("<tr><td>%1</td><td>%2</td><td>%3</td></tr>",
			СтрокаМаршрута.НомерЭтапа,
			ЭкранироватьHTML(СтрокаМаршрута.НазваниеЭтапа),
			ЭкранироватьHTML(Строка(СтрокаМаршрута.Согласующий))));
	КонецЦикла;
	Строки.Добавить("</table>");
	Строки.Добавить("<p><small>Сформировано ДокМаршрут. На учебной платформе вместо PDF используется HTML.</small></p>");
	Строки.Добавить("</body></html>");
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция ЭкранироватьHTML(Значение)

	Текст = Строка(Значение);
	Текст = СтрЗаменить(Текст, "&", "&amp;");
	Текст = СтрЗаменить(Текст, "<", "&lt;");
	Текст = СтрЗаменить(Текст, ">", "&gt;");
	Текст = СтрЗаменить(Текст, """", "&quot;");
	Возврат Текст;

КонецФункции
