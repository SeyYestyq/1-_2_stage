#Область ПрограммныйИнтерфейс

// Передает уведомление после фиксации транзакции согласования.
// ДокументСсылка - ДокументСсылка.ДокументСЭД.
// Событие - Строка. Комментарий - Строка.
Процедура ОтправитьПоСобытию(ДокументСсылка, Событие, Комментарий = "") Экспорт

	ПриСменеСтатуса(ДокументСсылка, Событие, Комментарий);

КонецПроцедуры

// Запускает рассылку о сохраненном статусе; файловая база выполняет ее синхронно.
// ДокументСсылка - ДокументСсылка.ДокументСЭД.
// Событие - Строка. Комментарий - Строка.
Процедура ПриСменеСтатуса(ДокументСсылка, Событие, Комментарий = "") Экспорт

	Если ТранзакцияАктивна() Тогда
		Возврат;
	КонецЕсли;
	Попытка
		СтрокаСоединения = ВРег(СтрокаСоединенияИнформационнойБазы());
		Если СтрНачинаетсяС(СтрокаСоединения, "FILE=") Тогда
			ДоставитьУведомление(ДокументСсылка, Событие, Комментарий);
		Иначе
			Параметры = Новый Массив;
			Параметры.Добавить(ДокументСсылка);
			Параметры.Добавить(Событие);
			Параметры.Добавить(Комментарий);
			ФоновыеЗадания.Выполнить("Уведомления.ДоставитьУведомление", Параметры, , "Почта ДокМаршрут");
		КонецЕсли;
	Исключение
		ЗаписатьВЖурнал(ДокументСсылка, "", Событие, Ложь,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Формирует вложение и выполняет отправку получателям, в том числе из фонового задания.
// ДокументСсылка - ДокументСсылка.ДокументСЭД.
// Событие - Строка. Комментарий - Строка.
Процедура ДоставитьУведомление(ДокументСсылка, Событие, Комментарий) Экспорт

	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	Получатели = Новый Массив;
	Если ЗначениеЗаполнено(ДокументОбъект.Ответственный) Тогда
		Получатели.Добавить(ДокументОбъект.Ответственный);
	КонецЕсли;
	Руководитель = ПечатьДокументов.РуководительОтветственного(ДокументОбъект);
	Если ЗначениеЗаполнено(Руководитель) И Получатели.Найти(Руководитель) = Неопределено Тогда
		Получатели.Добавить(Руководитель);
	КонецЕсли;
	Если Получатели.Количество() = 0 Тогда
		ЗаписатьВЖурнал(ДокументСсылка, "", Событие, Ложь, "Не определен ответственный за документ.");
		Возврат;
	КонецЕсли;

	ИмяФайлаВложения = "";
	Попытка
		Вложение = ПечатьДокументов.СформироватьВложениеПечатнойФормы(ДокументСсылка);
		Если Вложение.Успех Тогда
			ИмяФайлаВложения = Вложение.ИмяФайла;
		КонецЕсли;

		ТемаИТекст = СформироватьТемаИТекст(ДокументСсылка, Событие, Комментарий, Вложение);
		ИмяВложения = ТемаИТекст.ИмяВложения;
		Если Вложение.Успех И Не ПустаяСтрока(Вложение.ИмяФайлаКлиент) Тогда
			ИмяВложения = Вложение.ИмяФайлаКлиент;
		КонецЕсли;

		ОтправленныеАдреса = Новый Массив;
		Для Каждого Сотрудник Из Получатели Цикл
			Адрес = EmailСотрудника(Сотрудник);
			Если ПустаяСтрока(Адрес) Тогда
				ЗаписатьВЖурнал(ДокументСсылка, Адрес, Событие, Ложь, "У сотрудника не указан Email");
				Продолжить;
			КонецЕсли;
			КлючАдреса = НРег(Адрес);
			Если ОтправленныеАдреса.Найти(КлючАдреса) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ОтправленныеАдреса.Добавить(КлючАдреса);
			Если Не Вложение.Успех Тогда
				ЗаписатьВЖурнал(ДокументСсылка, Адрес, Событие, Ложь, Вложение.Текст);
				Продолжить;
			КонецЕсли;
			Результат = ОтправитьПисьмо(Адрес, ТемаИТекст.Тема, ТемаИТекст.Текст,
				ИмяФайлаВложения, ИмяВложения, Истина);
			ЗаписатьВЖурнал(ДокументСсылка, Адрес, Событие, Результат.Успех, Результат.ТекстОшибки);
		КонецЦикла;
	Исключение
		ЗаписатьВЖурнал(
			ДокументСсылка,
			"",
			Событие,
			Ложь,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Не ПустаяСтрока(ИмяФайлаВложения) Тогда
		Попытка
			УдалитьФайлы(ИмяФайлаВложения);
		Исключение
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

// Отправляет проверочное письмо и регистрирует результат.
// АдресПолучателя - Строка. По умолчанию адрес отправителя.
// Возвращаемое значение - Структура, Успех и Текст.
Функция ПроверитьОтправку(АдресПолучателя = "") Экспорт

	ПроверитьДоступКНастройкамSMTP();

	Результат = Новый Структура("Успех, Текст", Ложь, "");
	Адрес = СокрЛП(АдресПолучателя);
	Если ПустаяСтрока(Адрес) Тогда
		Адрес = СокрЛП(Константы.АдресОтправителя.Получить());
	КонецЕсли;
	Если ПустаяСтрока(Адрес) Тогда
		Результат.Текст =
			"Укажите адрес отправителя в блоке «Отправитель» или email получателя.";
		Возврат Результат;
	КонецЕсли;

	Тема = "ДокМаршрут: проверка почты";
	Текст = "Тестовое письмо. Если оно пришло, почта настроена.";
	Отправка = ОтправитьПисьмо(Адрес, Тема, Текст, "", "");
	ЗаписатьВЖурнал(Документы.ДокументСЭД.ПустаяСсылка(), Адрес, "Проверка SMTP",
		Отправка.Успех, Отправка.ТекстОшибки);
	Результат.Успех = Отправка.Успех;
	Если Отправка.Успех Тогда
		Результат.Текст = "Тестовое письмо отправлено на " + Адрес + ".";
	Иначе
		Результат.Текст = Отправка.ТекстОшибки;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Отправляет печатную форму выбранному адресу или участникам документа.
// ДокументСсылка - ДокументСсылка.ДокументСЭД. АдресПолучателя - Строка.
// Возвращаемое значение - Структура, Успех и Текст.
Функция ОтправитьПечатнуюФормуДокумента(ДокументСсылка, АдресПолучателя = "") Экспорт

	Результат = Новый Структура("Успех, Текст", Ложь, "");
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Результат.Текст = "Сначала запишите документ.";
		Возврат Результат;
	КонецЕсли;

	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	ПолучателиАдреса = Новый Массив;
	ОписаниеКому = Новый Массив;

	АдресЯвный = СокрЛП(АдресПолучателя);
	Если Не ПустаяСтрока(АдресЯвный) Тогда
		ПолучателиАдреса.Добавить(АдресЯвный);
		ОписаниеКому.Добавить(АдресЯвный);
	Иначе
		ДобавитьАдресПолучателяФормы(ПолучателиАдреса, ОписаниеКому, ДокументОбъект.Ответственный, "ответственный");
		ДобавитьАдресПолучателяФормы(ПолучателиАдреса, ОписаниеКому,
			ПечатьДокументов.РуководительОтветственного(ДокументОбъект), "руководитель");
	КонецЕсли;

	Если ПолучателиАдреса.Количество() = 0 Тогда
		Результат.Текст =
			"Нет получателей. В блоке «Кто участвует» заполните «Ответственный» "
			+ "или «Руководитель» и укажите Email в карточке сотрудника. "
			+ "Автор письма не получает.";
		Возврат Результат;
	КонецЕсли;

	Вложение = ПечатьДокументов.СформироватьВложениеПечатнойФормы(ДокументСсылка);
	Если Не Вложение.Успех Тогда
		Результат.Текст = Вложение.Текст;
		Возврат Результат;
	КонецЕсли;

	ТемаИТекст = СформироватьТемаИТекст(ДокументСсылка, "ПечатнаяФорма", "", Вложение);
	ИмяВложения = ?(ПустаяСтрока(Вложение.ИмяФайлаКлиент), ТемаИТекст.ИмяВложения, Вложение.ИмяФайлаКлиент);

	Успехов = 0;
	Ошибки = Новый Массив;
	Для Каждого Адрес Из ПолучателиАдреса Цикл
		Отправка = ОтправитьПисьмо(Адрес, ТемаИТекст.Тема, ТемаИТекст.Текст, Вложение.ИмяФайла, ИмяВложения, Истина);
		ЗаписатьВЖурнал(ДокументСсылка, Адрес, "ПечатнаяФорма", Отправка.Успех, Отправка.ТекстОшибки);
		Если Отправка.Успех Тогда
			Успехов = Успехов + 1;
		Иначе
			Ошибки.Добавить(Адрес + ": " + Отправка.ТекстОшибки);
		КонецЕсли;
	КонецЦикла;

	Если Не ПустаяСтрока(Вложение.ИмяФайла) Тогда
		Попытка
			УдалитьФайлы(Вложение.ИмяФайла);
		Исключение
		КонецПопытки;
	КонецЕсли;

	КомуТекст = СтрСоединить(ОписаниеКому, "; ");
	Результат.Успех = Успехов > 0;
	Если Результат.Успех Тогда
		Результат.Текст = СтрШаблон("Письмо отправлено (%1): %2.", Вложение.ФорматВложения, КомуТекст);
		Если Ошибки.Количество() > 0 Тогда
			Результат.Текст = Результат.Текст + Символы.ПС
				+ "Часть адресов не приняла письмо: " + СтрСоединить(Ошибки, "; ");
		КонецЕсли;
	Иначе
		Результат.Текст = "Письмо не отправлено." + Символы.ПС + СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Возвращает подсказку о получателях писем для карточки документа.
// ДокументОбъект - ДокументОбъект.ДокументСЭД.
// Возвращаемое значение - Строка.
Функция ТекстКомуУходятПисьма(ДокументОбъект) Экспорт

	Части = Новый Массив;
	Если ЗначениеЗаполнено(ДокументОбъект.Ответственный) Тогда
		Адрес = EmailСотрудника(ДокументОбъект.Ответственный);
		Если ПустаяСтрока(Адрес) Тогда
			Части.Добавить(Строка(ДокументОбъект.Ответственный) + " (нет Email)");
		Иначе
			Части.Добавить(Строка(ДокументОбъект.Ответственный) + " <" + Адрес + ">");
		КонецЕсли;
	КонецЕсли;
	Руководитель = ПечатьДокументов.РуководительОтветственного(ДокументОбъект);
	Если ЗначениеЗаполнено(Руководитель) И Руководитель <> ДокументОбъект.Ответственный Тогда
		Адрес = EmailСотрудника(Руководитель);
		Метка = Строка(Руководитель);
		Если ПустаяСтрока(Адрес) Тогда
			Части.Добавить(Метка + " (нет Email)");
		ИначеЕсли Части.Найти(Метка + " <" + Адрес + ">") = Неопределено Тогда
			Части.Добавить(Метка + " <" + Адрес + ">");
		КонецЕсли;
	КонецЕсли;

	Если Части.Количество() = 0 Тогда
		Возврат "Письма уйдут ответственному и руководителю. "
			+ "Заполните поля выше и Email в карточке сотрудника. Автор письма не получает.";
	КонецЕсли;
	Возврат "Письма: " + СтрСоединить(Части, "; ") + ". Автор письма не получает.";

КонецФункции

// Записывает настройки SMTP. Пустой пароль оставляет сохраненный пароль.
// Настройки - Структура, параметры сервера и отправителя.
Процедура ЗаписатьНастройкиSMTP(Настройки) Экспорт

	ПроверитьДоступКНастройкамSMTP();
	Если ПустаяСтрока(Настройки.АдресSMTP) Или Настройки.ПортSMTP < 1
		Или Настройки.ПортSMTP > 65535 Или Настройки.ТаймаутSMTP < 1
		Или Не ПочтовыйАдресДопустим(СокрЛП(Настройки.АдресОтправителя)) Тогда
		ВызватьИсключение "Укажите сервер, допустимый порт, положительный таймаут и адрес отправителя.";
	КонецЕсли;

	Константы.АдресSMTP.Установить(СокрЛП(Настройки.АдресSMTP));
	Константы.ПортSMTP.Установить(Настройки.ПортSMTP);
	Константы.ИспользоватьSSL.Установить(Настройки.ИспользоватьSSL);
	Константы.ЛогинSMTP.Установить(СокрЛП(Настройки.ЛогинSMTP));
	Если Не ПустаяСтрока(Настройки.ПарольSMTP) Тогда
		Константы.ПарольSMTP.Установить(Настройки.ПарольSMTP);
	КонецЕсли;
	Константы.АдресОтправителя.Установить(СокрЛП(Настройки.АдресОтправителя));
	Константы.ТаймаутSMTP.Установить(Настройки.ТаймаутSMTP);

КонецПроцедуры

// Возвращает настройки SMTP для формы администратора.
// Возвращаемое значение - Структура, параметры сервера и отправителя.
Функция ПрочитатьНастройкиSMTP() Экспорт

	ПроверитьДоступКНастройкамSMTP();

	Настройки = Новый Структура;
	Настройки.Вставить("АдресSMTP", Константы.АдресSMTP.Получить());
	Настройки.Вставить("ПортSMTP", Константы.ПортSMTP.Получить());
	Настройки.Вставить("ИспользоватьSSL", Константы.ИспользоватьSSL.Получить());
	Настройки.Вставить("ЛогинSMTP", Константы.ЛогинSMTP.Получить());
	Настройки.Вставить("АдресОтправителя", Константы.АдресОтправителя.Получить());
	Настройки.Вставить("ТаймаутSMTP", Константы.ТаймаутSMTP.Получить());
	Возврат Настройки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьДоступКНастройкамSMTP()

	Если Не РольДоступна("ПолныеПрава") Тогда
		ВызватьИсключение "Настройки почты доступны только администратору.";
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьАдресПолучателяФормы(ПолучателиАдреса, ОписаниеКому, СотрудникСсылка, РольТекст)

	Если Не ЗначениеЗаполнено(СотрудникСсылка) Тогда
		Возврат;
	КонецЕсли;
	Адрес = EmailСотрудника(СотрудникСсылка);
	Если ПустаяСтрока(Адрес) Тогда
		Возврат;
	КонецЕсли;
	Если ПолучателиАдреса.Найти(НРег(Адрес)) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолучателиАдреса.Добавить(НРег(Адрес));
	ОписаниеКому.Добавить(РольТекст + " " + Строка(СотрудникСсылка) + " <" + Адрес + ">");

КонецПроцедуры

Функция СформироватьТемаИТекст(ДокументСсылка, Событие, Комментарий, Вложение = Неопределено)

	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	ВидТекст = Строка(ДокументОбъект.ВидДокумента);
	НомерТекст = СокрЛП(ДокументОбъект.Номер);
	СтатусТекст = Строка(ДокументОбъект.Статус);
	ЭтапТекст = "—";
	Если ДокументОбъект.ВсегоЭтапов > 0 Тогда
		ЭтапНомер = ?(ДокументОбъект.ТекущийЭтап = 0, ДокументОбъект.ВсегоЭтапов, ДокументОбъект.ТекущийЭтап);
		ЭтапТекст = СтрШаблон("%1 из %2", ЭтапНомер, ДокументОбъект.ВсегоЭтапов);
	КонецЕсли;

	Тема = СтрШаблон("%1 № %2: %3", ВидТекст, НомерТекст, СтатусТекст);

	ФорматВложения = "PDF";
	Если ТипЗнч(Вложение) = Тип("Структура") И Вложение.Свойство("ФорматВложения")
		И Не ПустаяСтрока(Вложение.ФорматВложения) Тогда
		ФорматВложения = Вложение.ФорматВложения;
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("Документ: %1 № %2 от %3", ВидТекст, НомерТекст, Формат(ДокументОбъект.Дата, "ДЛФ=D")));
	Строки.Добавить("Статус: " + СтатусТекст);
	Строки.Добавить("Этап: " + ЭтапТекст);
	Строки.Добавить("Событие: " + ПредставлениеСобытияПисьма(Событие));
	Если ЗначениеЗаполнено(ДокументОбъект.ТекущийСогласующий) Тогда
		Строки.Добавить("Сейчас согласует: " + Строка(ДокументОбъект.ТекущийСогласующий));
	КонецЕсли;
	История = Согласование.ИсторияДляКарточки(ДокументСсылка);
	Если История.Количество() > 0 И Событие <> "ПечатнаяФорма" Тогда
		ПоследнееРешение = История[История.Количество() - 1];
		Строки.Добавить("Решение принял: " + ПоследнееРешение.Сотрудник);
	КонецЕсли;
	Если Не ПустаяСтрока(Комментарий) Тогда
		Строки.Добавить("Комментарий: " + Комментарий);
	КонецЕсли;
	Попытка
		Строки.Добавить("Ссылка: " + ПолучитьНавигационнуюСсылку(ДокументСсылка));
	Исключение
	КонецПопытки;
	Строки.Добавить("");
	Если ФорматВложения = "HTML" Тогда
		Строки.Добавить("Во вложении печатная форма (HTML). На учебной версии PDF недоступен.");
	Иначе
		Строки.Добавить("Во вложении печатная форма (PDF).");
	КонецЕсли;

	ИмяВложения = СтрШаблон("%1_%2.%3", НомерТекст, СтрЗаменить(ВидТекст, " ", "_"), НРег(ФорматВложения));
	Возврат Новый Структура("Тема, Текст, ИмяВложения", Тема, ТекстПисьмаHTML(Строки), ИмяВложения);

КонецФункции

Функция ПредставлениеСобытияПисьма(Событие)

	Ключ = СокрЛП(Строка(Событие));
	Если Ключ = "ПечатнаяФорма" Тогда
		Возврат "Отправка печатной формы";
	ИначеЕсли Ключ = "ОтправленНаСогласование" Тогда
		Возврат "Отправлен на согласование";
	ИначеЕсли Ключ = "Согласовано" Тогда
		Возврат "Согласовано";
	ИначеЕсли Ключ = "Отклонено" Тогда
		Возврат "Отклонено";
	ИначеЕсли Ключ = "ВозвращенНаДоработку" Тогда
		Возврат "Возвращён на доработку";
	КонецЕсли;
	Возврат Ключ;

КонецФункции

Функция ОтправитьПисьмо(АдресПолучателя, Тема, Текст, ИмяФайлаPDF, ИмяВложения, ЭтоHTML = Ложь)

	Результат = Новый Структура("Успех, ТекстОшибки", Ложь, "");
	Если Не ПочтовыйАдресДопустим(АдресПолучателя) Тогда
		Результат.ТекстОшибки = "Некорректный адрес получателя.";
		Возврат Результат;
	КонецЕсли;
	Если Не ПочтовыйАдресДопустим(Константы.АдресОтправителя.Получить()) Тогда
		Результат.ТекстОшибки = "Укажите корректный адрес отправителя в настройках почты.";
		Возврат Результат;
	КонецЕсли;
	Если Константы.ПортSMTP.Получить() <= 0 Или Константы.ТаймаутSMTP.Получить() <= 0 Тогда
		Результат.ТекстОшибки = "Укажите порт и положительный таймаут в настройках почты.";
		Возврат Результат;
	КонецЕсли;
	Если ПустаяСтрока(Константы.АдресSMTP.Получить()) Тогда
		Результат.ТекстОшибки = "Не заполнены настройки почты. Откройте «Настройки почты» в разделе «Сервис».";
		Возврат Результат;
	КонецЕсли;

	Почта = Неопределено;
	Попытка
		Профиль = ПрофильSMTP();
		Письмо = Новый ИнтернетПочтовоеСообщение;
		Письмо.Получатели.Добавить(АдресПолучателя);
		Письмо.Отправитель = Константы.АдресОтправителя.Получить();
		Письмо.Тема = Тема;
		Если ЭтоHTML Тогда
			Письмо.Тексты.Добавить(Текст, ТипТекстаПочтовогоСообщения.HTML);
		Иначе
			Письмо.Тексты.Добавить(Текст);
		КонецЕсли;

		Если Не ПустаяСтрока(ИмяФайлаPDF) Тогда
			ДанныеPDF = Новый ДвоичныеДанные(ИмяФайлаPDF);
			ИмяФайла = ?(ПустаяСтрока(ИмяВложения), "document.pdf", ИмяВложения);
			Письмо.Вложения.Добавить(ДанныеPDF, ИмяФайла);
		КонецЕсли;

		Почта = Новый ИнтернетПочта;
		Почта.Подключиться(Профиль);
		Почта.Послать(Письмо);
		Результат.Успех = Истина;
	Исключение
		Результат.ТекстОшибки = ТекстОшибкиОтправки(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Почта <> Неопределено Тогда
		Попытка
			Почта.Отключиться();
		Исключение
		КонецПопытки;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ПочтовыйАдресДопустим(Адрес)

	Если СтрДлина(Адрес) > 150 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайтиПоРегулярномуВыражению(Адрес,
		"\A[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+\z").НачальнаяПозиция > 0;

КонецФункции

Функция ТекстПисьмаHTML(Строки)

	Абзацы = Новый Массив;
	Для Каждого СтрокаПисьма Из Строки Цикл
		Текст = СтрЗаменить(СтрокаПисьма, "&", "&amp;");
		Текст = СтрЗаменить(Текст, "<", "&lt;");
		Текст = СтрЗаменить(Текст, ">", "&gt;");
		Абзацы.Добавить("<p>" + Текст + "</p>");
	КонецЦикла;
	Возврат "<html><body>" + СтрСоединить(Абзацы, Символы.ПС) + "</body></html>";

КонецФункции

Функция ТекстОшибкиОтправки(ТекстПлатформы)

	Текст = СокрЛП(Строка(ТекстПлатформы));
	Пароль = Константы.ПарольSMTP.Получить();
	Если Не ПустаяСтрока(Пароль) Тогда
		Текст = СтрЗаменить(Текст, Пароль, "[скрыто]");
	КонецЕсли;
	Если ПустаяСтрока(Текст) Тогда
		Возврат "Не удалось отправить письмо.";
	КонецЕсли;

	Если СтрНачинаетсяС(ВРег(Текст), "НЕ УДАЛОСЬ")
		Или СтрНачинаетсяС(ВРег(Текст), "ОШИБКА")
		Или СтрНачинаетсяС(ВРег(Текст), "НЕ ЗАПОЛНЕНЫ")
		Или СтрНачинаетсяС(ВРег(Текст), "У СОТРУДНИКА")
		Или СтрНачинаетсяС(ВРег(Текст), "УКАЖИТЕ") Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат "Не удалось отправить письмо: " + Текст;

КонецФункции

Функция ПрофильSMTP()

	Профиль = Новый ИнтернетПочтовыйПрофиль;
	Профиль.АдресСервераSMTP = Константы.АдресSMTP.Получить();
	Профиль.ПортSMTP = Константы.ПортSMTP.Получить();
	Профиль.ПользовательSMTP = Константы.ЛогинSMTP.Получить();
	Профиль.ПарольSMTP = Константы.ПарольSMTP.Получить();
	Профиль.ИспользоватьSSLSMTP = Константы.ИспользоватьSSL.Получить();
	Профиль.Таймаут = Константы.ТаймаутSMTP.Получить();
	Возврат Профиль;

КонецФункции

Функция EmailСотрудника(СотрудникСсылка)

	Если Не ЗначениеЗаполнено(СотрудникСсылка) Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(СотрудникСсылка.ПолучитьОбъект().Email);

КонецФункции

Процедура ЗаписатьВЖурнал(ДокументСсылка, Получатель, Событие, Успешно, ТекстОшибки)

	ОшибкаОтправки = ?(Успешно, "", ТекстОшибкиОтправки(ТекстОшибки));
	Если Не Успешно Тогда
		ЗаписьЖурналаРегистрации("ДокМаршрут.Почта", УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ДокументСЭД, ДокументСсылка, ОшибкаОтправки);
	КонецЕсли;
	Попытка
		СохранитьПопытку(ДокументСсылка, Получатель, Событие, Успешно, ОшибкаОтправки);
	Исключение
		ЗаписьЖурналаРегистрации("ДокМаршрут.ЖурналУведомлений", УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ДокументСЭД, ДокументСсылка,
			ТекстОшибкиОтправки(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

КонецПроцедуры

Процедура СохранитьПопытку(ДокументСсылка, Получатель, Событие, Успешно, ОшибкаОтправки)

	Менеджер = РегистрыСведений.ЖурналУведомлений.СоздатьМенеджерЗаписи();
	Менеджер.ИдентификаторПопытки = Строка(Новый УникальныйИдентификатор());
	Менеджер.Документ = ДокументСсылка;
	Менеджер.ДатаВремя = ТекущаяДатаСеанса();
	Менеджер.Получатель = Лев(Получатель, 150);
	Менеджер.Канал = Перечисления.КаналыУведомлений.ЭлектроннаяПочта;
	Менеджер.Событие = ПредставлениеСобытияПисьма(Событие);
	Менеджер.Успешно = Успешно;
	Менеджер.ТекстОшибки = ОшибкаОтправки;
	Менеджер.Попытка = 1;
	Менеджер.Записать();

КонецПроцедуры

#КонецОбласти
