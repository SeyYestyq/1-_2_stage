// Копирует описание полей вида в табличную часть документа (режим предприятия без смены конфигурации).
Процедура ЗаполнитьЗначенияПолейИзВида(ДокументОбъект, ВидОбъект) Экспорт

	Для Каждого СтрокаПоля Из ВидОбъект.Поля Цикл
		Если СтрокаПоля.Скрыто Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ДокументОбъект.ЗначенияПолей.Добавить();
		НоваяСтрока.Идентификатор = СтрокаПоля.Идентификатор;
		НоваяСтрока.Заголовок = СтрокаПоля.Заголовок;
	КонецЦикла;

КонецПроцедуры

// Наименования из справочника ЗначенияПолей для поля вида с типом «Выбор из списка».
Функция НаименованияЗначенийСписка(ВидСсылка, ИдентификаторПоля) Экспорт

	Результат = Новый Массив;
	Если Не ЗначениеЗаполнено(ВидСсылка) Или ПустаяСтрока(ИдентификаторПоля) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗначенияПолей.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ЗначенияПолей КАК ЗначенияПолей
	|ГДЕ
	|	ЗначенияПолей.Владелец = &Вид
	|	И ЗначенияПолей.ИдентификаторПоля = &ИдентификаторПоля
	|	И НЕ ЗначенияПолей.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	Запрос.УстановитьПараметр("Вид", ВидСсылка);
	Запрос.УстановитьПараметр("ИдентификаторПоля", ИдентификаторПоля);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Наименование);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Тип поля в шаблоне вида по идентификатору (для настройки выпадающего списка в документе).
Функция ТипПоляПоИдентификатору(ВидСсылка, ИдентификаторПоля) Экспорт

	Если Не ЗначениеЗаполнено(ВидСсылка) Или ПустаяСтрока(ИдентификаторПоля) Тогда
		Возврат Перечисления.ТипыПолей.ПустаяСсылка();
	КонецЕсли;

	ВидОбъект = ВидСсылка.ПолучитьОбъект();
	Для Каждого СтрокаПоля Из ВидОбъект.Поля Цикл
		Если СтрокаПоля.Идентификатор = ИдентификаторПоля Тогда
			Возврат СтрокаПоля.ТипПоля;
		КонецЕсли;
	КонецЦикла;
	Возврат Перечисления.ТипыПолей.ПустаяСсылка();

КонецФункции

Функция ТекстПроверкиОбязательных(ДокументОбъект) Экспорт

	Если Не ЗначениеЗаполнено(ДокументОбъект.ВидДокумента) Тогда
		Возврат "Нельзя отправить. В поле «Вид документа» выберите значение.";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДокументОбъект.Ответственный) Тогда
		Возврат "Нельзя отправить. В блоке «Кто участвует» в поле «Ответственный» выберите сотрудника.";
	КонецЕсли;

	ВидОбъект = ДокументОбъект.ВидДокумента.ПолучитьОбъект();
	ЗначенияПоИд = Новый Соответствие;
	Для Каждого СтрокаЗначения Из ДокументОбъект.ЗначенияПолей Цикл
		ЗначенияПоИд.Вставить(СтрокаЗначения.Идентификатор, СтрокаЗначения.ЗначениеСтрока);
	КонецЦикла;

	Незаполненные = Новый Массив;
	Для Каждого СтрокаПоля Из ВидОбъект.Поля Цикл
		Если Не СтрокаПоля.Обязательное Или СтрокаПоля.Скрыто Тогда
			Продолжить;
		КонецЕсли;
		Значение = ЗначенияПоИд.Получить(СтрокаПоля.Идентификатор);
		Если ПустаяСтрока(Значение) Тогда
			Незаполненные.Добавить("«" + СтрокаПоля.Заголовок + "»");
		КонецЕсли;
	КонецЦикла;

	Если Незаполненные.Количество() > 0 Тогда
		Возврат "Нельзя отправить. В таблице «Поля документа» заполните "
			+ СтрСоединить(Незаполненные, ", ") + ".";
	КонецЕсли;

	ТекстФормата = ТекстОшибокФорматаПоВиду(ВидОбъект, ЗначенияПоИд, "Нельзя отправить");
	Если Не ПустаяСтрока(ТекстФормата) Тогда
		Возврат ТекстФормата;
	КонецЕсли;

	Возврат "";

КонецФункции

// Только формат уже введённых значений (черновик можно сохранить неполным).
Функция ТекстПроверкиФорматаПолей(ДокументОбъект) Экспорт

	Если Не ЗначениеЗаполнено(ДокументОбъект.ВидДокумента) Тогда
		Возврат "";
	КонецЕсли;

	ВидОбъект = ДокументОбъект.ВидДокумента.ПолучитьОбъект();
	ЗначенияПоИд = Новый Соответствие;
	Для Каждого СтрокаЗначения Из ДокументОбъект.ЗначенияПолей Цикл
		ЗначенияПоИд.Вставить(СтрокаЗначения.Идентификатор, СтрокаЗначения.ЗначениеСтрока);
	КонецЦикла;

	Возврат ТекстОшибокФорматаПоВиду(ВидОбъект, ЗначенияПоИд, "Нельзя записать");

КонецФункции

Функция ТекстОшибокФорматаПоВиду(ВидОбъект, ЗначенияПоИд, ПрефиксСообщения)

	Для Каждого СтрокаПоля Из ВидОбъект.Поля Цикл
		Если СтрокаПоля.Скрыто Тогда
			Продолжить;
		КонецЕсли;
		Значение = СокрЛП(Строка(ЗначенияПоИд.Получить(СтрокаПоля.Идентификатор)));
		Если ПустаяСтрока(Значение) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаПоля.ТипПоля = Перечисления.ТипыПолей.Число Тогда
			Если Не ЗначениеЭтоЧисло(Значение) Тогда
				Возврат ПрефиксСообщения + ". В таблице «Поля документа» в строке «"
					+ СтрокаПоля.Заголовок + "» укажите число.";
			КонецЕсли;
		ИначеЕсли СтрокаПоля.ТипПоля = Перечисления.ТипыПолей.Дата Тогда
			Если Не ЗначениеЭтоДата(Значение) Тогда
				Возврат ПрефиксСообщения + ". В таблице «Поля документа» в строке «"
					+ СтрокаПоля.Заголовок + "» укажите дату (например 31.12.2026).";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ЗначениеЭтоЧисло(Значение)

	Попытка
		Проверка = Число(СтрЗаменить(Значение, " ", ""));
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция ЗначениеЭтоДата(Значение)

	Попытка
		Проверка = Дата(Значение);
		Возврат Истина;
	Исключение
	КонецПопытки;

	Попытка
		Части = СтрРазделить(Значение, ".");
		Если Части.Количество() <> 3 Тогда
			Возврат Ложь;
		КонецЕсли;
		Проверка = Дата(Число(Части[2]), Число(Части[1]), Число(Части[0]));
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции
