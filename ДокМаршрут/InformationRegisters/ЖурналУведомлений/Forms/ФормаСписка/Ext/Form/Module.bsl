&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Заголовок = "Журнал уведомлений";
	ТолькоПросмотр = Истина;
	ОтборТолькоОшибки = Ложь;
	ПрименитьОтборы();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИнструкцию(Команда)

	Текст =
	"Журнал уведомлений
	|
	|Здесь видны письма, которые ДокМаршрут уже отправил или пытался отправить.
	|Записи появляются сами — при смене статуса документа и при «Отправить на почту».
	|
	|В шапке: «Документ», «Получатель», «Событие» и галочка «Только ошибки».
	|Создавать строки вручную не нужно.";
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияСправки", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ОК, , , "Справка");

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияСправки(РезультатВопроса, ДополнительныеПараметры) Экспорт
КонецПроцедуры

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)

	ПрименитьОтборы();

КонецПроцедуры

&НаСервере
Процедура ПрименитьОтборы()

	Отбор = Список.Отбор;
	УдалитьОтборПоПолю(Отбор, "Документ");
	УдалитьОтборПоПолю(Отбор, "Получатель");
	УдалитьОтборПоПолю(Отбор, "Событие");
	УдалитьОтборПоПолю(Отбор, "Успешно");

	Если ЗначениеЗаполнено(ОтборДокумент) Тогда
		ДобавитьОтбор(Отбор, "Документ", ВидСравненияКомпоновкиДанных.Равно, ОтборДокумент);
	КонецЕсли;
	Если Не ПустаяСтрока(СокрЛП(ОтборПолучатель)) Тогда
		ДобавитьОтбор(Отбор, "Получатель", ВидСравненияКомпоновкиДанных.Содержит, СокрЛП(ОтборПолучатель));
	КонецЕсли;
	Если Не ПустаяСтрока(СокрЛП(ОтборСобытие)) Тогда
		ДобавитьОтбор(Отбор, "Событие", ВидСравненияКомпоновкиДанных.Содержит, СокрЛП(ОтборСобытие));
	КонецЕсли;
	Если ОтборТолькоОшибки Тогда
		ДобавитьОтбор(Отбор, "Успешно", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ДобавитьОтбор(Отбор, ИмяПоля, ВидСравнения, Значение)

	ЭлементОтбора = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
	ЭлементОтбора.ВидСравнения = ВидСравнения;
	ЭлементОтбора.ПравоеЗначение = Значение;
	ЭлементОтбора.Использование = Истина;

КонецПроцедуры

&НаСервере
Процедура УдалитьОтборПоПолю(Отбор, ИмяПоля)

	КУдалению = Новый Массив;
	Для Каждого ЭлементОтбора Из Отбор.Элементы Цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных")
			И Строка(ЭлементОтбора.ЛевоеЗначение) = ИмяПоля Тогда
			КУдалению.Добавить(ЭлементОтбора);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ЭлементОтбора Из КУдалению Цикл
		Отбор.Элементы.Удалить(ЭлементОтбора);
	КонецЦикла;

КонецПроцедуры
