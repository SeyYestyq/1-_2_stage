#Область ОбработчикиСобытий

// Новый вид всегда начинается как черновик настройки: статус «Готов» ставит только
// КонструкторВидов.ПроверитьИСохранитьШаблон, когда ошибок нет.
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если Новый() И (СтатусНастройки = Неопределено Или СтатусНастройки.Пустая()) Тогда
		СтатусНастройки = Перечисления.СтатусыНастройкиВида.Черновик;
	КонецЕсли;

	// Вид, по которому уже есть документы, нельзя перевести обратно в «Черновик»:
	// иначе он исчезнет из выбора, а документы останутся без шаблона.
	Если Не Новый()
		И СтатусНастройки = Перечисления.СтатусыНастройкиВида.Черновик
		И ЕстьДокументыЭтогоВида() Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "По виду уже есть документы: вернуть его в статус «Черновик» нельзя.";
		Сообщение.ПутьКДанным = "СтатусНастройки";
		Сообщение.Сообщить();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЕстьДокументыЭтогоВида()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДокументСЭД.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ДокументСЭД КАК ДокументСЭД
		|ГДЕ
		|	ДокументСЭД.ВидДокумента = &Вид";
	Запрос.УстановитьПараметр("Вид", Ссылка);

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

#КонецОбласти
