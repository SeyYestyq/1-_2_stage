#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Вид без статуса (заведён до появления реквизита) считается черновиком:
	// в выборе при создании документа участвуют только виды со статусом «Готов».
	Если Не ЗначениеЗаполнено(Объект.СтатусНастройки) Тогда
		Объект.СтатусНастройки = Перечисления.СтатусыНастройкиВида.Черновик;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Вверх(Команда)

	ПереместитьТекущееПолеНаСервере(-1);

КонецПроцедуры

&НаКлиенте
Процедура Вниз(Команда)

	ПереместитьТекущееПолеНаСервере(1);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПоле(Команда)

	ДобавитьПолеНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗначениеСписка(Команда)

	СсылкаЗначения = ДобавитьЗначениеСпискаНаСервере();
	Если СсылкаЗначения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Значение вводится в форме элемента справочника: наименование — это и есть значение списка.
	ОткрытьФорму("Справочник.ЗначенияПолей.ФормаЭлемента", Новый Структура("Ключ", СсылкаЗначения));

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПоле(Команда)

	СсылкаПоля = СсылкаТекущегоПоляНаСервере();
	Если СсылкаПоля = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Заголовок и тип поля живут в элементе ПВХ ПоляДокументов, а не в табличной части вида.
	ОткрытьФорму("ПланВидовХарактеристик.ПоляДокументов.ФормаЭлемента", Новый Структура("Ключ", СсылкаПоля));

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИСохранитьШаблон(Команда)

	Если ПроверитьИСохранитьШаблонНаСервере() = 0 Тогда
		ОбновитьОтображениеДанных();
		ПоказатьОповещениеПользователя("Шаблон проверен и сохранён, вид получил статус «Готов».");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВJSON(Команда)

	JSONВида = ВыгрузитьВJSONНаСервере();
	Если Не ЗначениеЗаполнено(JSONВида) Тогда
		ПоказатьПредупреждение(, "Не удалось выгрузить вид в JSON. Смотрите сообщения формы.");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзJSON(Команда)

	Если Не ЗначениеЗаполнено(JSONВида) Тогда
		ПоказатьПредупреждение(, "Вставьте текст JSON в поле «JSON вида (выгрузка и загрузка)».");
		Возврат;
	КонецЕсли;

	СсылкаНовогоВида = ЗагрузитьИзJSONНаСервере();
	Если СсылкаНовогоВида = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Загрузка создаёт новый вид в статусе «Черновик» — открываем его в отдельном окне.
	ОткрытьФорму("Справочник.ВидыДокументов.ФормаВида", Новый Структура("Ключ", СсылкаНовогоВида));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПереместитьТекущееПолеНаСервере(Направление)

	Индекс = ИндексТекущейСтрокиПолей();
	Если Индекс < 0 Тогда
		СообщитьОбОшибке("Выберите поле в таблице «Поля».", "Объект.Поля");
		Возврат;
	КонецЕсли;

	НовыйИндекс = Индекс + Направление;
	Если НовыйИндекс < 0 Или НовыйИндекс >= Объект.Поля.Количество() Тогда
		Возврат;
	КонецЕсли;

	Объект.Поля.Сдвинуть(Индекс, Направление);
	ПеренумероватьПоля();

КонецПроцедуры

&НаСервере
Функция ИндексТекущейСтрокиПолей()

	Если Элементы.Поля.ТекущаяСтрока = Неопределено Тогда
		Возврат -1;
	КонецЕсли;
	Возврат Объект.Поля.Индекс(Элементы.Поля.ТекущаяСтрока);

КонецФункции

// Порядок — единственный критерий порядка полей в форме документа и в печати:
// после любой перестановки он пересчитывается целиком.
&НаСервере
Процедура ПеренумероватьПоля()

	Номер = 0;
	Для Каждого СтрокаПоля Из Объект.Поля Цикл
		Номер = Номер + 1;
		СтрокаПоля.Порядок = Номер;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьПолеНаСервере()

	Если Не ЗаписатьВидЕслиНужно() Тогда
		Возврат;
	КонецЕсли;

	ЭлементПоля = ПланыВидовХарактеристик.ПоляДокументов.СоздатьЭлемент();
	// Владелец поля — вид документа: поля вида остаются данными, метаданные не меняются.
	ЭлементПоля.ВидДокумента = Объект.Ссылка;
	Идентификатор = "Поле" + Формат(Объект.Поля.Количество() + 1, "ЧГ=0");
	// У плана видов характеристик нет владельца, поэтому Наименование уникально на весь план:
	// в него входит наименование вида, а идентификатор поля хранится отдельно.
	ЭлементПоля.Идентификатор = Идентификатор;
	ЭлементПоля.Наименование = УникальноеИмяЭлементаПоля(Идентификатор);
	ЭлементПоля.Заголовок = "Поле " + Формат(Объект.Поля.Количество() + 1, "ЧГ=0");
	ЭлементПоля.ТипПоля = Перечисления.ТипыПолей.Строка;
	ЭлементПоля.Записать();

	НоваяСтрока = Объект.Поля.Добавить();
	НоваяСтрока.Поле = ЭлементПоля.Ссылка;
	НоваяСтрока.Порядок = Объект.Поля.Количество();
	НоваяСтрока.Обязательное = Ложь;
	НоваяСтрока.Скрыто = Ложь;

КонецПроцедуры

// Элемент ПВХ не может сослаться на незаписанный вид, поэтому новый вид пишется до создания поля.
&НаСервере
Функция ЗаписатьВидЕслиНужно()

	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат Истина;
	КонецЕсли;

	Попытка
		Объект.Записать();
	Исключение
		СообщитьОбОшибке(ОписаниеОшибки(), "");
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

&НаСервере
Функция СсылкаТекущегоПоляНаСервере()

	Индекс = ИндексТекущейСтрокиПолей();
	Если Индекс < 0 Тогда
		СообщитьОбОшибке("Выберите поле в таблице «Поля».", "Объект.Поля");
		Возврат Неопределено;
	КонецЕсли;

	СтрокаПоля = Объект.Поля[Индекс];
	Если Не ЗначениеЗаполнено(СтрокаПоля.Поле) Тогда
		СообщитьОбОшибке("В строке не выбрано поле. Нажмите «Добавить поле».", "Объект.Поля");
		Возврат Неопределено;
	КонецЕсли;

	Возврат СтрокаПоля.Поле;

КонецФункции


// Наименование элемента ПВХ обязано быть уникальным на весь план видов характеристик:
// «<идентификатор> — <вид>», при совпадении добавляется номер.
&НаСервере
Функция УникальноеИмяЭлементаПоля(Идентификатор)

	Основа = Идентификатор + " — " + Объект.Наименование;
	Если СтрДлина(Основа) > 150 Тогда
		Основа = Лев(Основа, 150);
	КонецЕсли;

	Имя = Основа;
	Номер = 1;

	Пока ИмяЗанятоПолем(Имя) Цикл
		Номер = Номер + 1;
		Суффикс = " (" + Формат(Номер, "ЧГ=0") + ")";
		Имя = Лев(Основа, 150 - СтрДлина(Суффикс)) + Суффикс;
	КонецЦикла;

	Возврат Имя;

КонецФункции

&НаСервере
Функция ИмяЗанятоПолем(Имя)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПоляДокументов.Ссылка КАК Ссылка
		|ИЗ
		|	ПланВидовХарактеристик.ПоляДокументов КАК ПоляДокументов
		|ГДЕ
		|	ПоляДокументов.Наименование = &Наименование";
	Запрос.УстановитьПараметр("Наименование", Имя);

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

&НаСервере
Функция ДобавитьЗначениеСпискаНаСервере()

	Индекс = ИндексТекущейСтрокиПолей();
	Если Индекс < 0 Тогда
		СообщитьОбОшибке("Выберите поле в таблице «Поля».", "Объект.Поля");
		Возврат Неопределено;
	КонецЕсли;

	СтрокаПоля = Объект.Поля[Индекс];
	Если Не ЗначениеЗаполнено(СтрокаПоля.Поле) Тогда
		СообщитьОбОшибке("Сначала выберите поле в колонке «Поле».", "Объект.Поля");
		Возврат Неопределено;
	КонецЕсли;

	Поле = СтрокаПоля.Поле.ПолучитьОбъект();
	Если Поле.ТипПоля <> Перечисления.ТипыПолей.ВыборИзСписка Тогда
		СообщитьОбОшибке("Значения списка задаются только для поля с типом «Выбор из списка»: «"
			+ Поле.Заголовок + "».", "Объект.Поля");
		Возврат Неопределено;
	КонецЕсли;

	// ТРЕБУЕТ РЕШЕНИЯ: состав Справочника ЗначенияПолей в spec/metadata.json не описан.
	// По документу «01_Angelina» справочник подчинён ПВХ ПоляДокументов, поэтому владелец — само поле.
	Значение = Справочники.ЗначенияПолей.СоздатьЭлемент();
	Значение.Владелец = СтрокаПоля.Поле;
	Значение.Наименование = "Новое значение";
	Значение.Записать();

	Возврат Значение.Ссылка;

КонецФункции

&НаСервере
Функция ПроверитьИСохранитьШаблонНаСервере()

	Ошибки = КонструкторВидов.ПроверитьИСохранитьШаблон(Объект);
	ВывестиОшибкиШаблона(Ошибки);
	Возврат Ошибки.Количество();

КонецФункции

// Контракт ошибок ядра: массив структур {Поле, Текст}. Поле — имя реквизита, табличной части
// или поля вида; для общих ошибок — пустая строка. Текст может быть пустым — тогда подставляем свой.
&НаСервере
Процедура ВывестиОшибкиШаблона(Ошибки)

	Для Каждого Ошибка Из Ошибки Цикл

		ИмяПоля = "";
		Если Ошибка.Свойство("Поле") И Ошибка.Поле <> Неопределено Тогда
			ИмяПоля = СокрЛП(Ошибка.Поле);
		КонецЕсли;

		Текст = "";
		Если Ошибка.Свойство("Текст") И Ошибка.Текст <> Неопределено Тогда
			Текст = СокрЛП(Ошибка.Текст);
		КонецЕсли;

		Если Не ЗначениеЗаполнено(Текст) Тогда
			Текст = ТекстОшибкиПоУмолчанию(ИмяПоля);
		КонецЕсли;

		СообщитьОбОшибке(Текст, ПутьКДаннымПоИмениПоля(ИмяПоля));

	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ТекстОшибкиПоУмолчанию(ИмяПоля)

	Если ИмяПоля = "Наименование" Тогда
		Возврат "Не заполнено наименование вида документа.";
	ИначеЕсли ИмяПоля = "Категория" Тогда
		Возврат "Не выбрана категория вида документа.";
	ИначеЕсли ИмяПоля = "Поля" Тогда
		Возврат "Проверьте состав полей: нужен хотя бы один неудалённый уникальный идентификатор поля,"
			+ " а у поля «Выбор из списка» — не меньше двух значений.";
	ИначеЕсли ИмяПоля = "Маршрут" Тогда
		Возврат "Проверьте маршрут: не меньше двух этапов, у каждого этапа свой согласующий,"
			+ " не меньше двух разных сотрудников и никто не стоит два этапа подряд.";
	КонецЕсли;

	Возврат "Ошибка проверки шаблона: «" + ИмяПоля + "».";

КонецФункции

&НаСервере
Функция ПутьКДаннымПоИмениПоля(ИмяПоля)

	Если ИмяПоля = "Наименование" Тогда
		Возврат "Объект.Description";
	ИначеЕсли ИмяПоля = "Категория" Тогда
		Возврат "Объект.Категория";
	ИначеЕсли ИмяПоля = "Поля" Тогда
		Возврат "Объект.Поля";
	ИначеЕсли ИмяПоля = "Маршрут" Тогда
		Возврат "Объект.Маршрут";
	КонецЕсли;

	Возврат "";

КонецФункции

&НаСервере
Процедура СообщитьОбОшибке(Текст, ПутьКДаннымПоля = "")

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Если ЗначениеЗаполнено(ПутьКДаннымПоля) Тогда
		Сообщение.Поле = ПутьКДаннымПоля;
	КонецЕсли;
	Сообщение.Сообщить();

КонецПроцедуры

&НаСервере
Функция ВыгрузитьВJSONНаСервере()

	Попытка
		Возврат КонструкторВидов.ВыгрузитьВидВJSON(Объект);
	Исключение
		СообщитьОбОшибке("Не удалось выгрузить вид в JSON: " + ОписаниеОшибки(), "");
		Возврат "";
	КонецПопытки;

КонецФункции

&НаСервере
Функция ЗагрузитьИзJSONНаСервере()

	Попытка
		НовыйВид = КонструкторВидов.ЗагрузитьВидИзJSON(JSONВида);
	Исключение
		СообщитьОбОшибке("Не удалось загрузить вид из JSON: " + ОписаниеОшибки(), "");
		Возврат Неопределено;
	КонецПопытки;

	// КонструкторВидов.ЗагрузитьВидИзJSON создаёт и записывает вид сам и возвращает ссылку.
	Если НовыйВид = Неопределено Или НовыйВид.Пустая() Тогда
		СообщитьОбОшибке("Вид из JSON не создан.", "");
		Возврат Неопределено;
	КонецЕсли;

	Возврат НовыйВид.Ссылка;

КонецФункции

#КонецОбласти
